---
const { title = 'SteelCalc | Steel Weight & Cost Calculators', description = 'Fast, practical steel weight and cost estimates for TMT bars, plates, pipes, and more.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f8" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  :global(html) { margin: 0; width: 100%; min-height: 100%; }
  :global(body) { margin: 0; min-width: 320px; min-height: 100vh; }
</style>
