  .hero{display:grid;grid-template-columns:1fr .9fr;align-items:center;gap:5%;padding:78px 0 70px;min-height:500px}.eyebrow{font-size:9px;font-weight:800;letter-spacing:2px;color:#8a949d;display:flex;align-items:center;gap:9px}.status-dot{width:6px;height:6px;background:#e6a13a;border-radius:50%;box-shadow:0 0 0 4px #f7ead7}.hero h1{font-size:clamp(43px,5vw,69px);line-height:1.04;letter-spacing:-3.8px;margin:24px 0 20px;font-weight:780;color:#17212b}.hero h1 em,.section-heading h2 em,.how-intro h2 em{font-family:Georgia,serif;font-weight:500;color:#c88427}.hero-lede{font-size:14px;line-height:1.85;color:#68737d;max-width:450px;margin:0}.hero-actions{display:flex;align-items:center;gap:19px;margin-top:29px}.primary-btn{display:inline-flex;align-items:center;gap:22px;padding:15px 19px;background:#17232e;color:#fff;text-decoration:none;font-size:11px;font-weight:750;border-radius:6px;box-shadow:0 5px 12px #18232d16}.primary-btn span{color:#efad4a;font-size:17px}.micro-note{font-size:10px;color:#8a949c}.hero-proof{display:flex;align-items:center;gap:8px;margin-top:28px;font-size:10px;color:#75808a}.proof-icon{display:grid;place-items:center;width:15px;height:15px;border-radius:50%;background:#e8f0e8;color:#56835a;font-size:9px;font-weight:800}.hero-proof i{height:3px;width:3px;background:#b4bcc2;border-radius:50%;margin:0 5px}
  .hero-visual{height:355px;position:relative;background:#e9edf0;border-radius:10px;overflow:hidden;border:1px solid #dfe4e7}.visual-grid{position:absolute;inset:0;background-image:linear-gradient(#cbd3d944 1px,transparent 1px),linear-gradient(90deg,#cbd3d944 1px,transparent 1px);background-size:27px 27px;mask-image:linear-gradient(135deg,#000,transparent 80%)}.visual-label{position:absolute;top:22px;left:24px;font-size:8px;font-weight:800;letter-spacing:1.7px;color:#8a969f}.steel-plate{position:absolute;width:66%;height:52%;left:18%;top:24%;transform:skewY(-13deg) rotate(-8deg);border-radius:4px}.plate-back{background:linear-gradient(125deg,#aeb9c1,#d9dfe3 40%,#87949e);box-shadow:14px 18px 0 #b8c1c8;opacity:.75;left:23%;top:20%}.plate-front{background:linear-gradient(145deg,#f9fafb 0%,#cbd3d9 35%,#aab5bd 60%,#e5e9ec 100%);border:1px solid #aeb8c0;box-shadow:0 24px 35px #27374426,inset 0 1px 1px #fff;overflow:hidden}.plate-sheen{position:absolute;inset:0;background:linear-gradient(115deg,transparent 20%,#fff8 48%,transparent 62%)}.plate-stamp{position:absolute;right:17px;bottom:15px;font-size:20px;font-weight:850;letter-spacing:-1px;color:#78848e;opacity:.7}.plate-stamp span{color:#d18a2d}.dimension{position:absolute;display:flex;align-items:center;gap:7px;color:#89949d;font-size:7px;font-weight:800;letter-spacing:1px}.dimension span{display:block;width:34px;height:1px;background:#aab4bc}.dimension-x{left:15%;bottom:20%}.dimension-y{right:9%;top:48%;transform:rotate(90deg)}.visual-caption{position:absolute;bottom:19px;left:23px;right:23px;display:flex;gap:11px;align-items:center;border-top:1px solid #cbd2d8;padding-top:13px}.visual-caption>span{font-family:Georgia,serif;color:#c4862c;font-size:20px}.visual-caption strong,.visual-caption small{display:block}.visual-caption strong{font-size:7px;letter-spacing:1.5px;color:#596671}.visual-caption small{font-size:9px;color:#8a959e;margin-top:4px}
  .stats-strip{display:grid;grid-template-columns:repeat(3,1fr) 1.6fr;align-items:center;border-top:1px solid #dfe4e7;border-bottom:1px solid #dfe4e7;padding:25px 0;gap:18px}.stats-strip>div{display:flex;align-items:center;gap:12px;border-right:1px solid #dfe4e7}.stats-strip strong{font-family:Georgia,serif;font-size:25px;font-weight:500;color:#c4862c}.stats-strip span{font-size:10px;color:#6f7a84;max-width:85px;line-height:1.4}.stats-strip p{font-size:10px;line-height:1.6;color:#8a949d;margin:0 0 0 12px}
  .tools-section{padding:85px 0 75px}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:30px}.section-heading h2,.how-intro h2{font-size:36px;line-height:1.15;letter-spacing:-1.5px;margin:14px 0 0;color:#17212b}.section-heading>p{max-width:330px;font-size:11px;line-height:1.8;color:#78838d;margin:0 0 3px}.tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tool-card{display:block;background:#fff;border:1px solid #e4e8eb;border-radius:8px;padding:21px 21px 17px;min-height:224px;transition:transform .2s,border-color .2s,box-shadow .2s;text-decoration:none;color:inherit}.tool-card:hover{transform:translateY(-3px);border-color:#d8b77f;box-shadow:0 12px 28px #18232d0a}.tool-card-top,.tool-card-bottom{display:flex;justify-content:space-between;align-items:center}.tool-number{font-size:10px;font-weight:800;color:#c4862c}.tool-tag{font-size:7px;letter-spacing:1.2px;color:#89949d;background:#f4f6f7;padding:6px 8px;border-radius:3px;font-weight:800}.tool-symbol{height:42px;width:49px;margin:18px 0 13px;position:relative}.symbol-line{position:absolute;left:3px;top:6px;width:35px;height:28px;border:1px solid #b8c2ca;transform:skewY(-23deg);background:linear-gradient(130deg,#f9fafb,#d9dfe3)}.symbol-block{position:absolute;left:12px;top:13px;width:31px;height:24px;border:1px solid #d4a45f;background:linear-gradient(135deg,#f2c77f,#d99a3c);transform:skewY(-23deg);box-shadow:3px 4px 0 #bd8536}.tool-card h3{font-size:15px;letter-spacing:-.3px;margin:0 0 8px;color:#202c36}.tool-card>p{font-size:10px;line-height:1.7;color:#7d8790;margin:0;max-width:270px;min-height:34px}.tool-card-bottom{border-top:1px solid #edf0f2;margin-top:17px;padding-top:12px}.tool-status{font-size:7px;letter-spacing:1.2px;font-weight:800;color:#a0a9b0}.tool-arrow{font-size:15px;color:#c4862c}.tool-note{font-size:10px;color:#929ba3;margin:17px 0 0}.tool-note a{color:#7b5a28;font-weight:750;text-decoration:underline;text-underline-offset:3px}.tool-note a:hover{color:#17212b}
  .how-section{display:grid;grid-template-columns:.8fr 1.2fr;gap:9%;padding:47px 0 64px;border-top:1px solid #e0e5e8}.how-intro h2{font-size:32px}.how-steps>div{display:flex;gap:20px;padding:0 0 19px;margin-bottom:18px;border-bottom:1px solid #e4e8eb}.how-steps>div:last-child{margin-bottom:0;border:0;padding-bottom:0}.how-steps>div>span{font-size:10px;font-weight:800;color:#c4862c;padding-top:2px}.how-steps h3{font-size:12px;margin:0 0 6px;color:#27333d}.how-steps p{font-size:10px;line-height:1.6;color:#7d8790;margin:0}footer{border-top:1px solid #dfe4e7;padding:24px 0 28px;display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-brand{font-size:16px}.footer-brand .brand-mark{width:27px;height:27px}.footer-brand small{font-size:7px}footer>p,footer>span{font-size:9px;color:#8a949d;margin:0}
  @media(min-width:1200px){.hero{padding-top:88px;padding-bottom:78px}}@media(max-width:900px){.site-shell{padding:0 5%}.hero{gap:4%;grid-template-columns:1fr  .85fr}.hero h1{font-size:54px}.hero-visual{height:315px}.stats-strip{grid-template-columns:repeat(3,1fr)}.stats-strip p{grid-column:1/-1;margin:0}.tool-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.site-shell{padding:0 20px}.topbar{height:75px}.topbar nav{display:none}.nav-cta{padding:10px 12px;font-size:10px}.hero{grid-template-columns:1fr;padding:54px 0 40px;gap:32px}.hero h1{font-size:49px;letter-spacing:-2.8px}.hero-lede{font-size:13px}.hero-visual{height:285px}.stats-strip{grid-template-columns:1fr 1fr;gap:15px;padding:21px 0}.stats-strip>div{border-right:0}.stats-strip p{grid-column:1/-1}.tools-section{padding:60px 0 52px}.section-heading{display:block}.section-heading h2{font-size:31px}.section-heading>p{margin-top:13px}.tool-grid{grid-template-columns:1fr;gap:11px}.tool-card{min-height:210px}.how-section{grid-template-columns:1fr;gap:28px;padding:38px 0 45px}.how-intro h2{font-size:30px}footer{align-items:flex-start;flex-wrap:wrap}footer>p{order:3;flex-basis:100%}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.tool-card{transition:none}}
</style>
