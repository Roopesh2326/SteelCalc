---
const tools = [
  {
    number: '01',
    title: 'Steel Weight',
    detail: 'Estimate weight from shape, dimensions, length, quantity, and density.',
    tag: 'WEIGHT',
    href: '/calculators/steel-weight',
    slug: 'weight'
  },
  {
    number: '02',
    title: 'TMT / Rebar',
    detail: 'Calculate nominal bar weight from diameter, length, and quantity.',
    tag: 'REBAR',
    href: '/calculators/tmt-rebar',
    slug: 'rebar'
  },
  {
    number: '03',
    title: 'Steel Plate',
    detail: 'Calculate plate weight from thickness, width, length, and sheets.',
    tag: 'PLATE',
    href: '/calculators/steel-plate',
    slug: 'plate'
  },
  {
    number: '04',
    title: 'Steel Pipe',
    detail: 'Estimate pipe weight using diameter, wall thickness, length, and density.',
    tag: 'PIPE',
    href: '/calculators/steel-pipe',
    slug: 'pipe'
  },
  {
    number: '05',
    title: 'Steel Cost',
    detail: 'Turn steel weight into a practical material-cost estimate.',
    tag: 'COST',
    href: '/calculators/steel-cost',
    slug: 'cost'
  },
];
---

<div class="site-shell">
  <header class="topbar">
    <a class="brand" href="/" aria-label="SteelCalc home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
    </a>

    <nav aria-label="Main navigation">
      <a href="/calculators">Calculators</a>
      <a href="#how-it-works">How it works</a>
    </nav>

    <form class="header-search" action="/calculators" role="search">
      <span aria-hidden="true">⌕</span>
      <input name="q" type="search" placeholder="Search calculators..." aria-label="Search calculators" autocomplete="off" />
    </form>

    <a class="nav-cta" href="/calculators">Explore tools <span aria-hidden="true">↗</span></a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> FREE STEEL CALCULATORS</div>
        <h1>Steel calculations.<br /><em>Made for real projects.</em></h1>
        <p class="hero-lede">Quick, practical steel weight and cost estimates for builders, fabricators, engineers, students, and anyone working with steel.</p>

        <div class="hero-actions">
          <a class="primary-btn" href="/calculators">Browse calculators <span aria-hidden="true">→</span></a>
          <a class="secondary-btn" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
        </div>

        <div class="hero-trust">
          <span><b>01</b> Metric inputs</span>
          <i></i>
          <span><b>02</b> Instant results</span>
          <i></i>
          <span><b>03</b> Shareable links</span>
        </div>
      </div>

      <div class="hero-visual" aria-label="Illustration of steel materials used by SteelCalc">
        <div class="scene-grid"></div>
        <div class="scene-glow"></div>
        <div class="scene-label scene-label-top">STEEL / TOOLKIT / 01</div>

        <div class="material-stack">
          <div class="rebar-bundle">
            <span></span><span></span><span></span><span></span><span></span>
          </div>

          <div class="plate-stack">
            <span></span><span></span><span></span>
          </div>

          <div class="pipe-piece">
            <div class="pipe-shadow"></div>
            <div class="pipe-ring"></div>
          </div>
        </div>

        <div class="scene-measure measure-left"><span></span><b>DIAMETER</b><span></span></div>
        <div class="scene-measure measure-bottom"><span></span><b>THICKNESS</b><span></span></div>

        <div class="scene-badge">
          <span class="badge-number">05</span>
          <div>
            <strong>ONE TOOLKIT</strong>
            <small>Weight · Rebar · Plate · Pipe · Cost</small>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-strip" aria-label="SteelCalc benefits">
      <div><strong>05</strong><span>Calculators</span></div>
      <div><strong>01</strong><span>Simple workflow</span></div>
      <div><strong>∞</strong><span>Quick calculations</span></div>
      <p>Free tools for material planning, checking quantities, and everyday steel estimates.</p>
    </section>

    <section class="tools-section" id="tools">
      <div class="section-heading">
        <div>
          <div class="eyebrow">THE TOOLKIT</div>
          <h2>Five tools. <em>One workflow.</em></h2>
        </div>
        <div class="section-side">
          <p>Pick the steel form you are working with, enter familiar measurements, and review the result instantly.</p>
          <a href="/calculators">View directory <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="tool-grid">
        {tools.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <div class="tool-card-top">
              <span class="tool-number">{tool.number}</span>
              <span class="tool-tag">{tool.tag}</span>
            </div>

            <div class={`tool-visual ${tool.slug}`} aria-hidden="true">
              {tool.slug === 'weight' && <><div class="bar bar-main"></div><div class="bar bar-shadow"></div><div class="measure-line"></div></>}
              {tool.slug === 'rebar' && <><div class="rebar-set"><span></span><span></span><span></span><span></span></div><div class="rebar-rings"></div></>}
              {tool.slug === 'plate' && <><div class="mini-plate p1"></div><div class="mini-plate p2"></div><div class="mini-plate p3"></div></>}
              {tool.slug === 'pipe' && <><div class="mini-pipe"></div><div class="mini-pipe-ring"></div></>}
              {tool.slug === 'cost' && <><div class="cost-sheet"></div><div class="cost-symbol">₹</div><div class="cost-line"></div></>}
            </div>

            <h3>{tool.title}</h3>
            <p>{tool.detail}</p>

            <div class="tool-card-bottom">
              <span>OPEN CALCULATOR</span>
              <span class="tool-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>

      <div class="tool-note-row">
        <p class="tool-note">All five calculators are live and built to work without an account.</p>
        <a class="directory-link" href="/calculators">Browse the full toolkit <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="how-section" id="how-it-works">
      <div class="how-intro">
        <div class="eyebrow">STRAIGHTFORWARD BY DESIGN</div>
        <h2>From dimensions<br />to <em>decisions.</em></h2>
        <p>Keep the workflow simple: choose the right tool, use the units shown, and review the estimate before you plan your next step.</p>
      </div>

      <div class="how-steps">
        <div>
          <span>01</span>
          <section>
            <h3>Choose your material</h3>
            <p>Start with the steel form closest to your project.</p>
          </section>
        </div>
        <div>
          <span>02</span>
          <section>
            <h3>Enter measurements</h3>
            <p>Use the dimensions and quantities already familiar to you.</p>
          </section>
        </div>
        <div>
          <span>03</span>
          <section>
            <h3>Review and share</h3>
            <p>Check the result, copy it, print it, or share the calculation link.</p>
          </section>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div>
      <a class="brand footer-brand" href="/">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
      </a>
      <p class="footer-copy">Practical steel estimates for builders, fabricators, engineers, students, and everyday planning.</p>
    </div>

    <div class="footer-col">
      <strong>Calculators</strong>
      <a href="/calculators/steel-weight">Steel Weight</a>
      <a href="/calculators/tmt-rebar">TMT / Rebar</a>
      <a href="/calculators/steel-plate">Steel Plate</a>
    </div>

    <div class="footer-col">
      <strong>Explore</strong>
      <a href="/calculators/steel-pipe">Steel Pipe</a>
      <a href="/calculators/steel-cost">Steel Cost</a>
      <a href="#how-it-works">How it works</a>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} SteelCalc. All rights reserved.</span>
      <span>Built for practical calculations.</span>
    </div>
  </footer>
</div>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#f6f7f8;color:#17212b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}

  .site-shell{max-width:1440px;margin:0 auto;padding:0 6.7%}

  .topbar{height:94px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid #e3e7e9}
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:#18232d;font-size:20px;font-weight:850;letter-spacing:-.8px;line-height:1}
  .brand-light{font-weight:450;color:#67727d}
  .brand small{display:block;font-size:8px;letter-spacing:2px;font-weight:750;color:#8b969f;margin-top:6px}
  .brand-mark{width:31px;height:31px;background:#e9a23b;border-radius:8px;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:7px}
  .brand-mark span{display:block;width:4px;background:#17212b;border-radius:1px}
  .brand-mark span:nth-child(1){height:8px}.brand-mark span:nth-child(2){height:14px}.brand-mark span:nth-child(3){height:11px}

  .topbar nav{display:flex;gap:32px}
  .topbar nav a{font-size:12px;font-weight:650;color:#65717c;text-decoration:none}
  .topbar nav a:hover{color:#17212b}

  .header-search{display:flex;align-items:center;gap:8px;width:210px;height:38px;border:1px solid #dde2e5;background:#fff;border-radius:7px;padding:0 11px}
  .header-search span{font-size:16px;color:#9aa3aa}
  .header-search input{width:100%;border:0;outline:0;background:transparent;font:inherit;font-size:9px;color:#25323b}
  .header-search input::placeholder{color:#a4adb4}

  .nav-cta{font-size:11px;font-weight:780;color:#17212b;text-decoration:none;border:1px solid #d7dde1;padding:11px 14px;border-radius:7px;white-space:nowrap}
  .nav-cta span{color:#d68c23;margin-left:8px}

  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(450px,.95fr);align-items:center;gap:6%;padding:72px 0 66px;min-height:555px}
  .eyebrow{font-size:9px;font-weight:850;letter-spacing:2px;color:#8a949d;display:flex;align-items:center;gap:9px}
  .status-dot{width:6px;height:6px;background:#e6a13a;border-radius:50%;box-shadow:0 0 0 4px #f7ead7}

  .hero h1{font-size:clamp(47px,5.2vw,74px);line-height:1.01;letter-spacing:-4px;margin:23px 0 20px;font-weight:790;color:#17212b;max-width:760px}
  .hero h1 em,.section-heading h2 em,.how-intro h2 em{font-family:Georgia,serif;font-weight:500;color:#c88427}
  .hero-lede{font-size:14px;line-height:1.85;color:#68737d;max-width:520px;margin:0}

  .hero-actions{display:flex;align-items:center;gap:10px;margin-top:30px}
  .primary-btn,.secondary-btn{display:inline-flex;align-items:center;gap:20px;padding:14px 17px;text-decoration:none;font-size:10px;font-weight:800;border-radius:6px}
  .primary-btn{background:#17232e;color:#fff;box-shadow:0 6px 14px #18232d12}
  .primary-btn span{color:#efad4a;font-size:16px}
  .secondary-btn{border:1px solid #d9dfe3;background:#fff;color:#5d6a73}
  .secondary-btn span{color:#c4862c;font-size:13px}

  .hero-trust{display:flex;align-items:center;gap:11px;margin-top:26px;font-size:9px;color:#7d8891}
  .hero-trust b{color:#c4862c;font-size:8px;margin-right:4px}
  .hero-trust i{width:3px;height:3px;background:#b6bec4;border-radius:50%}

  .hero-visual{height:420px;position:relative;background:linear-gradient(145deg,#eef1f3 0%,#e5eaed 55%,#eef1f2 100%);border:1px solid #dbe1e5;border-radius:14px;overflow:hidden;box-shadow:0 22px 42px #1b2b340d}
  .scene-grid{position:absolute;inset:0;background-image:linear-gradient(#cbd3d944 1px,transparent 1px),linear-gradient(90deg,#cbd3d944 1px,transparent 1px);background-size:31px 31px;mask-image:linear-gradient(135deg,#000,transparent 85%)}
  .scene-glow{position:absolute;width:290px;height:290px;border-radius:50%;right:-60px;top:42px;background:#ffffff77;filter:blur(2px)}
  .scene-label{position:absolute;font-size:8px;font-weight:850;letter-spacing:1.7px;color:#89959e}
  .scene-label-top{top:23px;left:26px}

  .material-stack{position:absolute;inset:0}
  .rebar-bundle{position:absolute;width:74%;height:120px;left:11%;top:85px;transform:rotate(-8deg)}
  .rebar-bundle span{position:absolute;width:85%;height:18px;left:8%;border-radius:999px;background:linear-gradient(180deg,#d9e0e4 0%,#7d8a94 38%,#4f5c66 65%,#a6b0b7 100%);box-shadow:0 7px 9px #27374422,inset 0 1px 1px #ffffffaa}
  .rebar-bundle span:nth-child(1){top:4px;left:4%}.rebar-bundle span:nth-child(2){top:23px;left:8%}.rebar-bundle span:nth-child(3){top:42px;left:12%}.rebar-bundle span:nth-child(4){top:61px;left:16%}.rebar-bundle span:nth-child(5){top:80px;left:20%}
  .rebar-bundle span:after{content:"";position:absolute;inset:5px 8% 5px 9%;border-top:2px dotted #e6ecef66;border-bottom:2px dotted #26343d55;border-radius:999px}

  .plate-stack{position:absolute;width:62%;height:112px;left:19%;bottom:83px;transform:skewY(-8deg) rotate(-3deg)}
  .plate-stack span{position:absolute;inset:auto 0 0 0;height:35px;border:1px solid #aab5bd;border-radius:4px;background:linear-gradient(145deg,#fbfcfc 0%,#d1d8dd 40%,#a5b0b8 64%,#edf0f2 100%);box-shadow:0 10px 13px #27374422}
  .plate-stack span:nth-child(1){bottom:0}.plate-stack span:nth-child(2){bottom:30px;left:5%;width:94%}.plate-stack span:nth-child(3){bottom:60px;left:10%;width:88%}

  .pipe-piece{position:absolute;right:10%;bottom:91px;width:118px;height:118px;transform:rotate(-11deg)}
  .pipe-shadow{position:absolute;width:105px;height:47px;right:0;top:34px;border-radius:50%;background:#54616b99;filter:blur(10px)}
  .pipe-ring{position:absolute;width:95px;height:95px;right:6px;top:0;border-radius:50%;background:radial-gradient(circle at 45% 42%,#fbfcfd 0 18%,#8d9aa3 20% 27%,#495660 29% 65%,#c1c9ce 67% 72%,#66737d 74% 100%);box-shadow:10px 16px 18px #27374424,inset 0 2px 4px #fff8}
  .pipe-ring:after{content:"";position:absolute;inset:22px;border-radius:50%;background:#24313a}

  .scene-measure{position:absolute;display:flex;align-items:center;gap:8px;color:#8b979f;font-size:7px;font-weight:850;letter-spacing:1px}
  .scene-measure span{display:block;width:36px;height:1px;background:#a9b3ba}
  .measure-left{left:8%;top:57%;transform:rotate(-3deg)}
  .measure-bottom{left:26%;bottom:29px}

  .scene-badge{position:absolute;bottom:18px;left:24px;right:24px;border-top:1px solid #c8d0d6;padding-top:13px;display:flex;align-items:center;gap:11px}
  .badge-number{font-family:Georgia,serif;color:#c4862c;font-size:22px}
  .scene-badge strong,.scene-badge small{display:block}
  .scene-badge strong{font-size:7px;letter-spacing:1.4px;color:#596670}.scene-badge small{font-size:9px;color:#89949d;margin-top:4px}

  .stats-strip{display:grid;grid-template-columns:repeat(3,1fr) 1.8fr;align-items:center;border-top:1px solid #dfe4e7;border-bottom:1px solid #dfe4e7;padding:25px 0;gap:18px}
  .stats-strip>div{display:flex;align-items:center;gap:12px;border-right:1px solid #dfe4e7}
  .stats-strip strong{font-family:Georgia,serif;font-size:25px;font-weight:500;color:#c4862c}
  .stats-strip span{font-size:10px;color:#6f7a84;max-width:85px;line-height:1.4}
  .stats-strip p{font-size:10px;line-height:1.7;color:#8a949d;margin:0 0 0 12px}

  .tools-section{padding:84px 0 78px}
  .section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:26px}
  .section-heading h2,.how-intro h2{font-size:36px;line-height:1.12;letter-spacing:-1.5px;margin:14px 0 0;color:#17212b}
  .section-side{display:flex;align-items:flex-end;gap:18px}
  .section-side p{max-width:365px;font-size:11px;line-height:1.8;color:#78838d;margin:0}
  .section-side a{white-space:nowrap;font-size:9px;font-weight:800;color:#65717a;text-decoration:none;border:1px solid #dce2e5;padding:10px 12px;border-radius:6px;background:#fff}
  .section-side a span{color:#c4862c;margin-left:6px}

  .tool-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
  .tool-card{display:flex;flex-direction:column;min-width:0;min-height:285px;background:#fff;border:1px solid #e1e6e9;border-radius:9px;padding:18px 17px 15px;transition:transform .2s,border-color .2s,box-shadow .2s;text-decoration:none;color:inherit}
  .tool-card:hover{transform:translateY(-4px);border-color:#d6b170;box-shadow:0 14px 30px #18232d0d}
  .tool-card-top,.tool-card-bottom{display:flex;justify-content:space-between;align-items:center}
  .tool-number{font-size:9px;font-weight:850;color:#c4862c}.tool-tag{font-size:7px;letter-spacing:1.2px;color:#89949d;background:#f4f6f7;padding:6px 7px;border-radius:3px;font-weight:800}
  .tool-visual{position:relative;height:78px;margin:16px 0 14px;border-radius:7px;overflow:hidden;background:linear-gradient(145deg,#f8fafb,#e8ecef);border:1px solid #e2e7ea}
  .tool-visual:after{content:"";position:absolute;inset:auto 10px 10px;height:1px;background:#d0d7dc}

  .tool-visual.weight .bar{position:absolute;height:12px;border-radius:999px;left:16px;right:17px;transform:rotate(-7deg);background:linear-gradient(180deg,#e6ebee,#84919b 42%,#52606a 68%,#bec7cc);box-shadow:0 5px 8px #27374425}
  .tool-visual.weight .bar-main{top:28px}.tool-visual.weight .bar-shadow{top:43px;left:31px;right:28px;opacity:.72}
  .tool-visual.weight .measure-line{position:absolute;width:36px;height:1px;left:15px;top:22px;background:#a7b1b8}

  .tool-visual.rebar .rebar-set{position:absolute;left:13px;right:13px;top:25px;transform:rotate(-9deg)}
  .tool-visual.rebar .rebar-set span{display:block;height:7px;margin:5px 0;border-radius:99px;background:linear-gradient(180deg,#e3e8eb,#56636d 60%,#9da8af);box-shadow:0 3px 5px #26353f18}
  .tool-visual.rebar .rebar-rings{position:absolute;right:13px;bottom:13px;width:27px;height:27px;border-radius:50%;border:6px solid #67747e;box-shadow:0 0 0 2px #d4dce1}

  .tool-visual.plate .mini-plate{position:absolute;width:70%;height:21px;left:15%;border-radius:3px;border:1px solid #adb8c0;background:linear-gradient(145deg,#fafbfb,#bec7cd,#e9edef);box-shadow:0 5px 8px #27374418;transform:skewY(-7deg)}
  .tool-visual.plate .p1{top:39px}.tool-visual.plate .p2{top:29px;left:19%}.tool-visual.plate .p3{top:19px;left:23%}

  .tool-visual.pipe .mini-pipe{position:absolute;width:78px;height:34px;left:30px;top:23px;transform:rotate(-15deg);border-radius:50%;background:linear-gradient(145deg,#f9fbfc,#8b979f 43%,#5a6872 68%,#d4dade);box-shadow:0 7px 10px #27374420}
  .tool-visual.pipe .mini-pipe:after{content:"";position:absolute;inset:8px 10px;border-radius:50%;background:#2d3b44}
  .tool-visual.pipe .mini-pipe-ring{position:absolute;left:91px;top:21px;width:40px;height:40px;border-radius:50%;border:7px solid #6b7882;background:#27343d;box-shadow:0 0 0 2px #c6ced3}

  .tool-visual.cost .cost-sheet{position:absolute;width:66px;height:50px;left:18px;top:15px;border:1px solid #bcc5ca;border-radius:4px;background:#fff;box-shadow:0 6px 10px #27374412;transform:rotate(-4deg)}
  .tool-visual.cost .cost-line{position:absolute;width:35px;height:1px;left:34px;top:35px;background:#d8a55e;box-shadow:0 8px 0 #e5e8ea,0 16px 0 #e5e8ea}
  .tool-visual.cost .cost-symbol{position:absolute;right:21px;top:22px;width:42px;height:42px;border-radius:50%;background:#d79335;color:#fff;display:grid;place-items:center;font-family:Georgia,serif;font-size:20px;font-weight:700;box-shadow:0 8px 12px #c4862c38}

  .tool-card h3{font-size:14px;letter-spacing:-.25px;margin:0 0 8px;color:#202c36}
  .tool-card>p{font-size:9.5px;line-height:1.7;color:#7d8790;margin:0;min-height:48px}
  .tool-card-bottom{border-top:1px solid #edf0f2;margin-top:auto;padding-top:12px}
  .tool-status{font-size:7px;letter-spacing:1.1px;font-weight:850;color:#9ca5ac}.tool-arrow{font-size:15px;color:#c4862c}

  .tool-note-row{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:17px}
  .tool-note{font-size:9px;color:#929ba3;margin:0}.directory-link{font-size:9px;font-weight:800;color:#66727b;text-decoration:none;border:1px solid #dde2e5;background:#fff;padding:9px 11px;border-radius:6px;white-space:nowrap}
  .directory-link span{color:#c4862c;margin-left:6px}.directory-link:hover{border-color:#d2b074;color:#17212b}

  .how-section{display:grid;grid-template-columns:.82fr 1.18fr;gap:9%;padding:50px 0 66px;border-top:1px solid #e0e5e8}
  .how-intro h2{font-size:33px}.how-intro>p{max-width:410px;font-size:11px;line-height:1.8;color:#7d8790;margin:16px 0 0}
