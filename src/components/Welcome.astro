---
const tools = [
  { number: '01', title: 'Steel Weight', detail: 'Estimate weight from shape, dimensions, length, and quantity.', tag: 'WEIGHT', href: '/calculators/steel-weight' },
  { number: '02', title: 'TMT / Rebar', detail: 'Calculate bar weight from diameter, length, and quantity.', tag: 'REBAR', href: '/calculators/tmt-rebar' },
  { number: '03', title: 'Steel Plate', detail: 'Work out plate weight from thickness, size, and quantity.', tag: 'PLATE', href: '/calculators/steel-plate' },
  { number: '04', title: 'Steel Pipe', detail: 'Estimate pipe weight using diameter, wall thickness, and length.', tag: 'PIPE', href: '/calculators/steel-pipe' },
  { number: '05', title: 'Steel Cost', detail: 'Turn steel weight into an estimated material cost.', tag: 'COST', href: '/calculators/steel-cost' },
];
---

<div class="site-shell">
  <header class="topbar">
    <a class="brand" href="/" aria-label="SteelCalc home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
    </a>
    <nav aria-label="Main navigation">
      <a href="/calculators">Calculators</a>
      <a href="#how-it-works">How it works</a>
    </nav>
    <a class="nav-cta" href="/calculators">Explore tools <span aria-hidden="true">↗</span></a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> BUILT FOR THE REAL WORLD</div>
        <h1>Steel calculations.<br /><em>Made simple.</em></h1>
        <p class="hero-lede">Quick, practical steel weight and cost estimates for builders, fabricators, engineers, and everyone working with steel.</p>
        <div class="hero-actions">
          <a class="primary-btn" href="#tools">Explore calculators <span aria-hidden="true">→</span></a>
          <span class="micro-note">Clear inputs. Useful answers.</span>
        </div>
        <div class="hero-proof"><span class="proof-icon">✓</span> Fast estimates <i></i><span class="proof-icon">✓</span> No sign-up required</div>
      </div>
      <div class="hero-visual" aria-label="Decorative steel material illustration">
        <div class="visual-grid"></div>
        <div class="visual-label label-top">MATERIAL / 01</div>
        <div class="steel-plate plate-back"></div>
        <div class="steel-plate plate-front"><div class="plate-sheen"></div><div class="plate-stamp">SC<span> / </span>01</div></div>
        <div class="dimension dimension-x"><span></span><b>LENGTH</b><span></span></div>
        <div class="dimension dimension-y"><span></span><b>THICKNESS</b><span></span></div>
        <div class="visual-caption"><span>01</span><div><strong>ENGINEERED FOR CLARITY</strong><small>Practical tools. Less guesswork.</small></div></div>
      </div>
    </section>

    <section class="stats-strip" aria-label="SteelCalc benefits">
      <div><strong>5</strong><span>Calculator categories</span></div>
      <div><strong>01</strong><span>Simple workflow</span></div>
      <div><strong>∞</strong><span>Ways to plan smarter</span></div>
      <p>Designed to make everyday steel estimates easier.</p>
    </section>

    <section class="tools-section" id="tools">
      <div class="section-heading">
        <div><div class="eyebrow">THE TOOLKIT</div><h2>Find the right <em>calculator.</em></h2></div>
        <p>Choose a tool to get started. Each calculator is designed around the measurements you already use.</p>
      </div>
      <div class="tool-grid">
        {tools.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <div class="tool-card-top"><span class="tool-number">{tool.number}</span><span class="tool-tag">{tool.tag}</span></div>
            <div class="tool-symbol" aria-hidden="true"><span class="symbol-line"></span><span class="symbol-block"></span></div>
            <h3>{tool.title}</h3>
            <p>{tool.detail}</p>
            <div class="tool-card-bottom"><span class="tool-status">OPEN CALCULATOR</span><span class="tool-arrow" aria-hidden="true">↗</span></div>
          </a>
        ))}
      </div>
      <p class="tool-note">Five calculators are live. Open the <a href="/calculators">calculator directory</a> to see the full toolkit in one place.</p>
    </section>

    <section class="how-section" id="how-it-works">
      <div class="how-intro"><div class="eyebrow">STRAIGHTFORWARD BY DESIGN</div><h2>From dimensions<br />to <em>decisions.</em></h2></div>
      <div class="how-steps">
        <div><span>01</span><section><h3>Choose your material</h3><p>Select the steel form that matches your project.</p></section></div>
        <div><span>02</span><section><h3>Enter measurements</h3><p>Use familiar dimensions and quantities.</p></section></div>
        <div><span>03</span><section><h3>Plan with confidence</h3><p>Use the estimate as a practical starting point for your next step.</p></section></div>
      </div>
    </section>
  </main>

  <footer><a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span></a><p>Practical steel estimates, without the extra steps.</p><span>© {new Date().getFullYear()} SteelCalc</span></footer>
</div>

<style>
