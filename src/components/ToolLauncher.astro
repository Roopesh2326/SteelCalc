---
interface Tool {
  number: string;
  title: string;
  detail: string;
  tag: string;
  href: string;
  visual: string;
}

interface Props {
  tools: Tool[];
}

const { tools } = Astro.props;
const toolData = tools.map((tool) => ({
  ...tool,
  category:
    ['WEIGHT', 'PLATE', 'PIPE', 'COST', 'STRUCTURAL'].includes(tool.tag)
      ? 'steel'
      : ['CONCRETE', 'MASONRY', 'PLASTER', 'FLOORING', 'EARTHWORK'].includes(tool.tag)
        ? 'construction'
        : ['REBAR', 'BBS'].includes(tool.tag)
          ? 'reinforcement'
          : 'other'
}));
---

<section class="launcher" aria-labelledby="launcher-title" data-tool-launcher>
  <div class="launcher-heading">
    <div>
      <span class="eyebrow">QUICK START</span>
      <h2 id="launcher-title">What are you <em>calculating?</em></h2>
      <p>Search by material or job. SteelCalc narrows the choices so you can start without hunting through a long list.</p>
    </div>
    <div class="launcher-shortcut" aria-label="Keyboard shortcut">
      <span>Keyboard</span><kbd>/</kbd>
    </div>
  </div>

  <div class="launcher-controls">
    <label class="launcher-search">
      <span aria-hidden="true">⌕</span>
      <input id="tool-search" type="search" placeholder="Try “steel weight”, “concrete”, or “BBS”" autocomplete="off" aria-label="Find a calculator" />
      <button type="button" id="clear-tool-search" aria-label="Clear search" hidden>×</button>
    </label>

    <div class="category-tabs" role="tablist" aria-label="Calculator categories">
      <button type="button" class="category-tab is-active" data-category="all" role="tab" aria-selected="true">All</button>
      <button type="button" class="category-tab" data-category="steel" role="tab" aria-selected="false">Steel</button>
      <button type="button" class="category-tab" data-category="construction" role="tab" aria-selected="false">Construction</button>
      <button type="button" class="category-tab" data-category="reinforcement" role="tab" aria-selected="false">Reinforcement</button>
    </div>
  </div>

  <div class="recent-row" id="recent-row" hidden>
    <div>
      <span class="recent-label">RECENT</span>
      <strong id="recent-title">Continue a calculation</strong>
    </div>
    <div class="recent-tools" id="recent-tools"></div>
  </div>

  <div class="launcher-grid" id="launcher-grid">
    {toolData.map((tool) => (
      <a
        class="launcher-card"
        href={tool.href}
        data-tool-card
        data-category={tool.category}
        data-title={tool.title.toLowerCase()}
        data-tag={tool.tag.toLowerCase()}
      >
        <span class="launcher-icon" aria-hidden="true">
          {tool.category === 'steel' ? '▦' : tool.category === 'construction' ? '⌗' : '⌘'}
        </span>
        <div class="launcher-card-main">
          <span class="launcher-card-tag">{tool.tag}</span>
          <h3>{tool.title}</h3>
          <p>{tool.detail}</p>
        </div>
        <span class="launcher-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>

  <div class="launcher-empty" id="launcher-empty" hidden>
    <strong>No calculator matched that search.</strong>
    <span>Try a simpler term such as steel, concrete, rebar, plate, or BBS.</span>
  </div>

  <div class="launcher-footer">
    <span id="launcher-count" aria-live="polite"></span>
    <a href="/calculators">Open the full calculator directory <span aria-hidden="true">→</span></a>
  </div>
</section>

<script>
  const launcher = document.querySelector('[data-tool-launcher]');
  const searchInput = launcher?.querySelector('#tool-search');
  const clearButton = launcher?.querySelector('#clear-tool-search');
  const tabs = Array.from(launcher?.querySelectorAll('.category-tab') || []);
  const cards = Array.from(launcher?.querySelectorAll('[data-tool-card]') || []);
  const emptyState = launcher?.querySelector('#launcher-empty');
  const countLabel = launcher?.querySelector('#launcher-count');
  const recentRow = launcher?.querySelector('#recent-row');
  const recentTools = launcher?.querySelector('#recent-tools');

  let activeCategory = 'all';

  const matches = (card) => {
    const query = searchInput?.value.trim().toLowerCase() || '';
    const category = card.getAttribute('data-category') || 'other';
    const title = card.getAttribute('data-title') || '';
    const tag = card.getAttribute('data-tag') || '';
    const categoryMatch = activeCategory === 'all' || category === activeCategory;
    const queryMatch = !query || title.includes(query) || tag.includes(query);
    return categoryMatch && queryMatch;
  };

  const renderRecent = () => {
    if (!recentRow || !recentTools) return;
    try {
      const recent = JSON.parse(localStorage.getItem('steelcalc-recent-tools') || '[]');
      const valid = recent.filter((item) => item && item.href && item.title).slice(0, 3);
      if (!valid.length) {
        recentRow.hidden = true;
        return;
      }
      recentRow.hidden = false;
      recentTools.innerHTML = '';
      valid.forEach((item) => {
        const link = document.createElement('a');
        link.href = item.href;
        link.className = 'recent-tool';
        link.innerHTML = '<strong></strong><span>Continue →</span>';
        link.querySelector('strong').textContent = item.title;
        recentTools.appendChild(link);
      });
    } catch {
      recentRow.hidden = true;
    }
  };

  const render = () => {
    let visible = 0;
    cards.forEach((card) => {
      const show = matches(card);
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (emptyState) emptyState.hidden = visible !== 0;
    if (countLabel) countLabel.textContent = visible === cards.length ? `${visible} calculators` : `${visible} matching calculators`;
    if (clearButton) clearButton.hidden = !(searchInput?.value || '');
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activeCategory = tab.getAttribute('data-category') || 'all';
      tabs.forEach((item) => {
        const selected = item === tab;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-selected', String(selected));
      });
      render();
    });
  });

  searchInput?.addEventListener('input', render);
  clearButton?.addEventListener('click', () => {
    if (!searchInput) return;
    searchInput.value = '';
    searchInput.focus();
    render();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      event.preventDefault();
      searchInput?.focus();
    }
  });

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      try {
        const href = card.getAttribute('href');
        const title = card.querySelector('h3')?.textContent?.trim();
        if (!href || !title) return;
        const recent = JSON.parse(localStorage.getItem('steelcalc-recent-tools') || '[]')
          .filter((item) => item?.href !== href);
        recent.unshift({ href, title });
        localStorage.setItem('steelcalc-recent-tools', JSON.stringify(recent.slice(0, 6)));
      } catch {}
    });
  });

  renderRecent();
  render();
</script>

<style>
  .launcher {
    margin: 1.25rem 0 0;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 1px solid var(--sc-color-border, #294056);
    border-radius: var(--sc-radius-lg, 1.25rem);
    background: linear-gradient(145deg, #10243a, #0b1b2c 72%);
    box-shadow: var(--sc-shadow-soft, 0 14px 36px rgb(0 0 0 / 18%));
    position: relative;
    overflow: hidden;
  }
  .launcher::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, #f4b942, #d99522 48%, transparent);
  }
  .launcher-heading { display:flex; justify-content:space-between; gap:1.5rem; align-items:flex-end; }
  .launcher-heading h2 { font-size:clamp(1.55rem,2.5vw,2rem); letter-spacing:-.045em; margin:.5rem 0 .45rem; color:#f3f7fb; line-height:1.12; }
  .launcher-heading h2 em { font-family:Georgia,serif; font-weight:500; color:#f4b942; }
  .launcher-heading p { max-width:40rem; margin:0; color:#b2c1cf; font-size:.9rem; line-height:1.65; }
  .launcher-shortcut { display:flex; align-items:center; gap:.5rem; color:#9fb0c1; font-size:.75rem; white-space:nowrap; }
  .launcher-shortcut kbd { border:1px solid #3b536b; border-bottom-width:2px; border-radius:.4rem; padding:.35rem .6rem; background:#142b42; color:#f3f7fb; font:700 .8rem var(--sc-font-sans,system-ui); }
  .launcher-controls { display:flex; gap:.75rem; align-items:center; margin-top:1.25rem; }
  .launcher-search { min-width:0; height:48px; flex:1; display:flex; align-items:center; gap:.65rem; border:1px solid #3a536b; background:#071625; border-radius:.65rem; padding:0 .85rem; }
  .launcher-search>span { font-size:1.2rem; color:#a9bac9; }
  .launcher-search input { border:0; outline:0; width:100%; min-width:0; font:inherit; font-size:1rem; color:#f3f7fb; background:transparent; }
  .launcher-search input::placeholder { color:#91a4b7; opacity:1; }
  .launcher-search button { min-width:36px; min-height:36px; border:0; border-radius:.4rem; background:transparent; color:#c5d2de; font-size:1.25rem; cursor:pointer; }
  .category-tabs { display:flex; gap:.4rem; align-items:center; }
  .category-tab { min-height:44px; border:1px solid #3a536b; background:#12283d; color:#d0dce6; border-radius:.55rem; padding:.65rem .9rem; font:700 .8rem var(--sc-font-sans,system-ui); cursor:pointer; white-space:nowrap; }
  .category-tab:hover { border-color:#7890a6; color:#fff; }
  .category-tab.is-active { background:#f4b942; color:#17212b; border-color:#f4b942; box-shadow:0 6px 16px rgb(0 0 0 / 18%); }
  .recent-row { display:flex; justify-content:space-between; align-items:center; gap:.9rem; margin-top:1rem; padding:.8rem .9rem; border:1px solid #344d65; border-radius:.65rem; background:#0a1a2a; }
  .recent-label { font-size:.65rem; font-weight:850; letter-spacing:.12em; color:#9fb0c1; display:block; }
  .recent-row strong { font-size:.9rem; color:#f3f7fb; }
  .recent-tools { display:flex; gap:.5rem; overflow:auto; }
  .recent-tool { display:flex; align-items:center; gap:.5rem; min-height:38px; padding:.4rem .6rem; border:1px solid #344d65; background:#12283d; border-radius:.5rem; text-decoration:none; white-space:nowrap; }
  .recent-tool strong { font-size:.8rem; color:#e6eef5; }
  .recent-tool span { font-size:.72rem; color:#f4b942; font-weight:800; }
  .launcher-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.7rem; margin-top:1rem; }
  .launcher-card { min-width:0; display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:.75rem; align-items:start; min-height:112px; border:1px solid #304960; border-radius:.7rem; padding:.9rem; background:#10243a; text-decoration:none; color:inherit; transition:transform .16s,border-color .16s,box-shadow .16s; }
  .launcher-card:hover { transform:translateY(-2px); border-color:#d5a744; box-shadow:0 10px 22px rgb(0 0 0 / 20%); }
  .launcher-card[hidden] { display:none; }
  .launcher-icon { width:36px; height:36px; border-radius:.55rem; display:grid; place-items:center; background:#253c52; color:#f4b942; font-size:1rem; font-weight:800; }
  .launcher-card-tag { font-size:.65rem; font-weight:850; letter-spacing:.12em; color:#a9bac9; }
  .launcher-card h3 { margin:.25rem 0 .35rem; font-size:.95rem; line-height:1.3; color:#f3f7fb; }
  .launcher-card p { margin:0; font-size:.8rem; line-height:1.5; color:#b2c1cf; }
  .launcher-arrow { font-size:1.1rem; color:#f4b942; line-height:1; }
  .launcher-empty { margin-top:1rem; padding:1.5rem; text-align:center; border:1px dashed #486078; border-radius:.65rem; background:#0a1a2a; }
  .launcher-empty strong,.launcher-empty span { display:block; }
  .launcher-empty strong { font-size:.9rem; color:#f3f7fb; }
  .launcher-empty span { font-size:.8rem; color:#b2c1cf; margin-top:.35rem; }
  .launcher-footer { display:flex; justify-content:space-between; align-items:center; gap:.9rem; margin-top:1rem; font-size:.78rem; color:#a9bac9; }
  .launcher-footer a { color:#f4c65f; text-decoration:none; font-weight:800; }
  .launcher-footer a:hover { color:#ffe09a; }
  .launcher :where(a,button,input):focus-visible { outline:3px solid #ffd36f; outline-offset:3px; }
  @media(max-width:1050px) {
    .launcher-controls { align-items:stretch; flex-direction:column; }
    .category-tabs { overflow:auto; padding:2px; }
    .launcher-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media(max-width:720px) {
    .launcher { padding:1.2rem 1rem 1rem; border-radius:.9rem; }
    .launcher-heading { display:block; }
    .launcher-shortcut { display:none; }
    .recent-row { display:block; }
    .recent-tools { margin-top:.5rem; }
    .recent-tool { flex:0 0 auto; }
    .launcher-footer { align-items:flex-start; flex-direction:column; }
  }
  @media(max-width:520px) {
    .launcher-grid { grid-template-columns:1fr; }
    .category-tabs { width:100%; }
    .category-tab { flex:0 0 auto; }
  }
  @media(prefers-reduced-motion:reduce) {
    .launcher-card { transition:none; }
    .launcher-card:hover { transform:none; }
  }
</style>
