---
interface Props {
  type: 'steel-weight' | 'tmt-rebar' | 'steel-plate' | 'steel-pipe' | 'steel-cost' | 'concrete' | 'masonry';
  eyebrow: string;
  title: string;
  accent: string;
  description: string;
  formula: string;
}

const { type, eyebrow, title, accent, description, formula } = Astro.props;
const labels: Record<Props['type'], { result: string; helper: string }> = {
  'steel-weight': { result: 'Estimated weight', helper: 'Based on steel density and entered dimensions.' },
  'tmt-rebar': { result: 'Total rebar weight', helper: 'Uses the nominal d² / 162.2 kg-per-metre method.' },
  'steel-plate': { result: 'Plate weight', helper: 'Calculated using 7.85 g/cm³ steel density.' },
  'steel-pipe': { result: 'Pipe weight', helper: 'Based on outside diameter, wall thickness, and length.' },
  'steel-cost': { result: 'Estimated material cost', helper: 'Weight × rate, with an optional allowance for waste.' },
  'concrete': { result: 'Concrete volume', helper: 'Wet volume with a configurable dry-volume factor and mix ratio.' },
  'masonry': { result: 'Masonry units', helper: 'Estimated brick or block count, mortar, cement, and sand.' },
};

const faqItems: Record<Props['type'], Array<{ question: string; answer: string }>> = {
  'steel-weight': [
    { question: 'How is steel bar weight calculated?', answer: 'Steel weight is calculated from the cross-sectional area, entered length, steel density, and quantity. Round bars use π × d² / 4; square and rectangular bars use their respective cross-sectional areas.' },
    { question: 'What steel density does SteelCalc use?', answer: 'The default density is 7,850 kg/m³. You can change the density input when a project specification calls for another value.' },
    { question: 'Is the result an exact purchase weight?', answer: 'No. It is a calculation estimate. Actual supplied weight can vary because of manufacturing tolerances, grade, coating, and supplier specifications.' }
  ],
  'tmt-rebar': [
    { question: 'What is the TMT rebar weight formula?', answer: 'SteelCalc uses the density-derived nominal relation d² / 162.2 to estimate kilograms per metre, then multiplies by bar length and the number of bars.' },
    { question: 'Can I calculate multiple TMT bars at once?', answer: 'Yes. Enter the length of one bar and the total number of bars to get the combined estimated weight.' },
    { question: 'Is d² / 162.2 the actual delivered weight?', answer: 'It is a nominal calculation method based on a 7,850 kg/m³ steel density. Actual supplied rebar weight can vary within applicable manufacturing tolerances and project specifications.' }
  ],
  'steel-plate': [
    { question: 'How is steel plate weight calculated?', answer: 'Plate weight is calculated from thickness × width × length × 0.00000785 when dimensions are entered in millimetres and the result is required in kilograms.' },
    { question: 'Can I calculate several sheets together?', answer: 'Yes. Enter the number of sheets in Quantity and SteelCalc multiplies the single-sheet estimate accordingly.' },
    { question: 'What density is assumed for steel plate?', answer: 'The calculator uses a nominal steel density of 7.85 g/cm³, equivalent to 7,850 kg/m³.' }
  ],
  'steel-pipe': [
    { question: 'How is steel pipe weight calculated?', answer: 'SteelCalc calculates the annular cross-sectional area from outside diameter and wall thickness, then applies length, quantity, and steel density.' },
    { question: 'Why must wall thickness be less than half the outside diameter?', answer: 'The inside diameter is OD − 2 × wall thickness. A valid pipe needs a positive inside diameter.' },
    { question: 'Can I change the steel density?', answer: 'Yes. The density input defaults to 7,850 kg/m³ and can be adjusted for a different specified material density.' }
  ],
  'steel-cost': [
    { question: 'How is steel cost estimated?', answer: 'The calculator multiplies weight by the entered rate per kilogram and quantity, then applies the optional waste or allowance percentage.' },
    { question: 'Does the waste percentage change the material weight?', answer: 'It changes the planning quantity used for the cost estimate. The base material amount remains visible in the result breakdown.' },
    { question: 'Does SteelCalc provide live market steel rates?', answer: 'No. The calculator uses the rate you enter. Supplier and market prices can change by location, grade, quantity, and time.' }
  ],
  'concrete': [
    { question: 'How is concrete volume calculated?', answer: 'Wet concrete volume is length × width × depth × quantity. The calculator then applies the entered dry-volume factor to estimate constituent material quantities.' },
    { question: 'What does the dry-volume factor do?', answer: 'It converts wet concrete volume into an estimated dry material volume for batching. The default example is 1.54, but you can change it to match your estimating practice or project specification.' },
    { question: 'Can I use a custom concrete mix ratio?', answer: 'Yes. Enter the cement, sand, and aggregate ratio parts. The calculator distributes dry volume across those parts and estimates cement bags from the entered bag weight.' },
    { question: 'Is this a structural mix-design calculator?', answer: 'No. It is a quantity-estimation tool. Final concrete mix proportions, water-cement ratio, strength class, admixtures, and construction requirements should follow the project specification and qualified engineering review.' }
  ],
  'masonry': [
    { question: 'How is brick or block quantity calculated?', answer: 'The calculator divides masonry wall volume by the unit module volume, where the module includes the entered mortar joint on the unit dimensions.' },
    { question: 'Why is mortar joint size included?', answer: 'A brick or block occupies space together with its surrounding mortar joints. Using a unit module gives a planning count that better reflects wall coverage than dividing only by the solid unit volume.' },
    { question: 'How are cement and sand estimated?', answer: 'The tool estimates wet mortar as wall volume minus the solid volume of the base unit count, then applies the entered dry-volume factor and cement:sand ratio.' },
    { question: 'Are these exact site quantities?', answer: 'No. They are planning estimates. Bond pattern, openings, joint thickness, breakage, cutting, workmanship, and project-specific mortar practice can change actual quantities.' }
  ]
};

const relatedTools: Record<Props['type'], Array<{ title: string; href: string }>> = {
  'steel-weight': [
    { title: 'TMT / Rebar Calculator', href: '/calculators/tmt-rebar' },
    { title: 'Steel Plate Calculator', href: '/calculators/steel-plate' },
    { title: 'Steel Pipe Calculator', href: '/calculators/steel-pipe' }
  ],
  'tmt-rebar': [
    { title: 'Steel Weight Calculator', href: '/calculators/steel-weight' },
    { title: 'Steel Cost Calculator', href: '/calculators/steel-cost' },
    { title: 'Steel Plate Calculator', href: '/calculators/steel-plate' }
  ],
  'steel-plate': [
    { title: 'Steel Weight Calculator', href: '/calculators/steel-weight' },
    { title: 'Steel Pipe Calculator', href: '/calculators/steel-pipe' },
    { title: 'Steel Cost Calculator', href: '/calculators/steel-cost' }
  ],
  'steel-pipe': [
    { title: 'Steel Weight Calculator', href: '/calculators/steel-weight' },
    { title: 'Steel Plate Calculator', href: '/calculators/steel-plate' },
    { title: 'Steel Cost Calculator', href: '/calculators/steel-cost' }
  ],
  'steel-cost': [
    { title: 'Steel Weight Calculator', href: '/calculators/steel-weight' },
    { title: 'TMT / Rebar Calculator', href: '/calculators/tmt-rebar' },
    { title: 'Steel Plate Calculator', href: '/calculators/steel-plate' }
  ],
  'concrete': [
    { title: 'TMT / Rebar Calculator', href: '/calculators/tmt-rebar' },
    { title: 'Project Workbench', href: '/workbench' },
    { title: 'Steel Cost Calculator', href: '/calculators/steel-cost' }
  ],
  'masonry': [
    { title: 'Concrete Calculator', href: '/calculators/concrete' },
    { title: 'TMT / Rebar Calculator', href: '/calculators/tmt-rebar' },
    { title: 'Project Workbench', href: '/workbench' }
  ]
};

const currentFaqItems = faqItems[type] ?? [];
const currentRelatedTools = relatedTools[type] ?? [];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: currentFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'SteelCalc', item: Astro.site ? new URL('/', Astro.site).toString() : undefined },
    { '@type': 'ListItem', position: 2, name: 'Calculators', item: Astro.site ? new URL('/calculators', Astro.site).toString() : undefined },
    { '@type': 'ListItem', position: 3, name: title, item: Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined }
  ].map((item) => Object.fromEntries(Object.entries(item).filter(([, value]) => value !== undefined)))
};
---

<a class="skip-link" href="#main-content">Skip to calculator</a>
<div class="calculator-page" data-calculator={type}>
  <header class="site-header">
    <a class="brand" href="/" aria-label="SteelCalc home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
    </a>
    <nav aria-label="Calculator navigation">
      <a href="/">Home</a>
      <a class="active" href="/calculators" aria-current="page">Calculators</a>
    </nav>
    <a class="header-cta" href="/calculators">All tools <span aria-hidden="true">↗</span></a>
  </header>

  <div class="calc-crumb" aria-label="Breadcrumb">
    <a href="/">SteelCalc</a><span>/</span><a href="/calculators">Calculators</a><span>/</span><span aria-current="page">{title}</span>
  </div>

  <main id="main-content">
  <section class="calc-hero">
    <div>
      <div class="eyebrow"><span class="status-dot"></span>{eyebrow}</div>
      <h1>{title} <em>{accent}</em></h1>
      <p>{description}</p>
    </div>
    <div class="hero-chip">
      <span>LIVE</span>
      <strong>Instant result</strong>
      <small>No sign-up. No spreadsheet needed.</small>
    </div>
  </section>

  <section class="calculator-card">
    <form class="calc-form" id="calc-form">
      <div class="form-head">
        <div><span class="form-kicker">INPUTS</span><h2>{type === 'concrete' ? 'Enter concrete inputs' : type === 'masonry' ? 'Enter masonry inputs' : 'Enter your dimensions'}</h2></div>
        <button class="ghost-btn" type="button" id="reset-btn">Reset</button>
      </div>
      <div id="form-error" role="alert" aria-live="polite"></div>

      {type === 'steel-weight' && (
        <>
          <div class="field full"><label for="shape">Shape</label><select id="shape"><option value="round">Round bar</option><option value="square">Square bar</option><option value="rect">Rectangular bar</option><option value="flat">Flat bar</option><option value="hex">Hex bar</option></select></div>
          <div class="field shape-round"><label for="diameter">Diameter <span>mm</span></label><input id="diameter" type="number" min="0" step="0.01" placeholder="20" /></div>
          <div class="field shape-square"><label for="side">Side <span>mm</span></label><input id="side" type="number" min="0" step="0.01" placeholder="20" /></div>
          <div class="field shape-rect"><label for="width">Width <span>mm</span></label><input id="width" type="number" min="0" step="0.01" placeholder="40" /></div>
          <div class="field shape-rect shape-flat"><label for="thickness">Thickness <span>mm</span></label><input id="thickness" type="number" min="0" step="0.01" placeholder="6" /></div>
          <div class="field shape-flat"><label for="flat-width">Width <span>mm</span></label><input id="flat-width" type="number" min="0" step="0.01" placeholder="40" /></div>
          <div class="field shape-hex"><label for="hex-side">Side <span>mm</span></label><input id="hex-side" type="number" min="0" step="0.01" placeholder="20" /></div>
          <div class="field"><label for="length">Length <span>m</span></label><input id="length" type="number" min="0" step="0.01" placeholder="6" /></div>
          <div class="field"><label for="quantity">Quantity <span>pcs</span></label><input id="quantity" type="number" min="1" step="1" placeholder="1" /></div>
          <div class="field"><label for="density">Density <span>kg/m³</span></label><input id="density" type="number" min="1" step="1" placeholder="7850" /></div>
        </>
      )}

      {type === 'tmt-rebar' && (
        <>
          <div class="field full"><label for="diameter">Bar diameter <span>mm</span></label><select id="diameter"><option value="" selected>Select diameter</option><option>6</option><option>8</option><option>10</option><option>12</option><option>16</option><option>20</option><option>25</option><option>28</option><option>32</option><option>36</option><option>40</option></select></div>
          <div class="field"><label for="length">Length per bar <span>m</span></label><input id="length" type="number" min="0" step="0.01" placeholder="12" /></div>
          <div class="field"><label for="quantity">Number of bars <span>pcs</span></label><input id="quantity" type="number" min="1" step="1" placeholder="10" /></div>
        </>
      )}

      {type === 'steel-plate' && (
        <>
          <div class="field"><label for="thickness">Thickness <span>mm</span></label><input id="thickness" type="number" min="0" step="0.01" placeholder="6" /></div>
          <div class="field"><label for="width">Width <span>mm</span></label><input id="width" type="number" min="0" step="0.01" placeholder="1220" /></div>
          <div class="field"><label for="length">Length <span>mm</span></label><input id="length" type="number" min="0" step="0.01" placeholder="2440" /></div>
          <div class="field"><label for="quantity">Quantity <span>sheets</span></label><input id="quantity" type="number" min="1" step="1" placeholder="1" /></div>
        </>
      )}

      {type === 'steel-pipe' && (
        <>
          <div class="field"><label for="outer-diameter">Outer diameter <span>mm</span></label><input id="outer-diameter" type="number" min="0" step="0.01" placeholder="60.3" /></div>
          <div class="field"><label for="thickness">Wall thickness <span>mm</span></label><input id="thickness" type="number" min="0" step="0.01" placeholder="3.2" /></div>
          <div class="field"><label for="length">Length <span>m</span></label><input id="length" type="number" min="0" step="0.01" placeholder="6" /></div>
          <div class="field"><label for="quantity">Quantity <span>pcs</span></label><input id="quantity" type="number" min="1" step="1" placeholder="1" /></div>
          <div class="field full"><label for="density">Density <span>kg/m³</span></label><input id="density" type="number" min="1" step="1" placeholder="7850" /></div>
        </>
      )}

      {type === 'steel-cost' && (
        <>
          <div class="field"><label for="weight">Weight <span>kg</span></label><input id="weight" type="number" min="0" step="0.01" placeholder="100" /></div>
          <div class="field"><label for="rate">Rate <span>₹ / kg</span></label><input id="rate" type="number" min="0" step="0.01" placeholder="75" /></div>
          <div class="field"><label for="quantity">Quantity <span>lots</span></label><input id="quantity" type="number" min="1" step="1" placeholder="1" /></div>
          <div class="field"><label for="waste">Waste / allowance <span>%</span></label><input id="waste" type="number" min="0" step="0.1" placeholder="0" /></div>
        </>
      )}

      {type === 'concrete' && (
        <>
          <div class="field full"><label for="element">Element type</label><select id="element"><option value="slab" selected>Slab</option><option value="beam">Beam</option><option value="column">Column</option><option value="footing">Footing</option><option value="other">Other</option></select></div>
          <div class="field"><label for="length">Length <span>m</span></label><input id="length" type="number" min="0" step="0.001" placeholder="4" /></div>
          <div class="field"><label for="width">Width <span>m</span></label><input id="width" type="number" min="0" step="0.001" placeholder="3" /></div>
          <div class="field"><label for="depth">Depth / thickness <span>m</span></label><input id="depth" type="number" min="0" step="0.001" placeholder="0.15" /></div>
          <div class="field"><label for="quantity">Quantity <span>nos.</span></label><input id="quantity" type="number" min="1" step="1" placeholder="1" /></div>
          <div class="field"><label for="dry-factor">Dry volume factor <span>×</span></label><input id="dry-factor" type="number" min="0" step="0.01" placeholder="1.54" /></div>
          <div class="field"><label for="cement-ratio">Cement ratio <span>parts</span></label><input id="cement-ratio" type="number" min="0" step="0.1" placeholder="1" /></div>
          <div class="field"><label for="sand-ratio">Sand ratio <span>parts</span></label><input id="sand-ratio" type="number" min="0" step="0.1" placeholder="2" /></div>
          <div class="field"><label for="aggregate-ratio">Aggregate ratio <span>parts</span></label><input id="aggregate-ratio" type="number" min="0" step="0.1" placeholder="4" /></div>
          <div class="field full"><label for="cement-bag">Cement bag weight <span>kg / bag</span></label><input id="cement-bag" type="number" min="0" step="0.1" placeholder="50" /></div>
        </>
      )}

      {type === 'masonry' && (
        <>
          <div class="field full"><label for="unit-type">Masonry unit</label><select id="unit-type"><option value="" selected>Select unit</option><option value="brick">Brick</option><option value="block">Concrete block</option></select></div>
          <div class="field"><label for="wall-length">Wall length <span>m</span></label><input id="wall-length" type="number" min="0" step="0.001" placeholder="6" /></div>
          <div class="field"><label for="wall-height">Wall height <span>m</span></label><input id="wall-height" type="number" min="0" step="0.001" placeholder="3" /></div>
          <div class="field"><label for="wall-thickness">Wall thickness <span>mm</span></label><input id="wall-thickness" type="number" min="0" step="0.1" placeholder="115" /></div>
          <div class="field"><label for="unit-length">Unit length <span>mm</span></label><input id="unit-length" type="number" min="0" step="0.1" placeholder="190" /></div>
          <div class="field"><label for="unit-height">Unit height <span>mm</span></label><input id="unit-height" type="number" min="0" step="0.1" placeholder="90" /></div>
          <div class="field"><label for="unit-thickness">Unit thickness <span>mm</span></label><input id="unit-thickness" type="number" min="0" step="0.1" placeholder="90" /></div>
          <div class="field"><label for="joint">Mortar joint <span>mm</span></label><input id="joint" type="number" min="0" step="0.1" placeholder="10" /></div>
          <div class="field"><label for="dry-mortar-factor">Dry mortar factor <span>×</span></label><input id="dry-mortar-factor" type="number" min="0" step="0.01" placeholder="1.33" /></div>
          <div class="field"><label for="cement-mortar-ratio">Cement ratio <span>parts</span></label><input id="cement-mortar-ratio" type="number" min="0" step="0.1" placeholder="1" /></div>
          <div class="field"><label for="sand-mortar-ratio">Sand ratio <span>parts</span></label><input id="sand-mortar-ratio" type="number" min="0" step="0.1" placeholder="4" /></div>
          <div class="field"><label for="cement-bag">Cement bag weight <span>kg / bag</span></label><input id="cement-bag" type="number" min="0" step="0.1" placeholder="50" /></div>
          <div class="field"><label for="masonry-wastage"><span>Optional</span> Wastage <span>%</span></label><input id="masonry-wastage" data-optional="true" type="number" min="0" step="0.1" placeholder="5" /></div>
        </>
      )}

      <div class="form-actions full">
        <button class="calculate-btn" type="submit">Calculate <span>→</span></button>
        <label class="auto-calc-toggle"><input id="auto-calc" type="checkbox" checked /> <span>Live results</span></label>
        <span class="keyboard-note">Press <kbd>Enter</kbd> to calculate</span>
      </div>
    </form>

    <aside class="result-panel">
      <div class="result-top">
        <span>RESULT</span>
        <div class="result-actions">
          <button type="button" id="print-btn" class="copy-btn">Print</button>
          <button type="button" id="share-btn" class="copy-btn">Share</button>
          <button type="button" id="copy-btn" class="copy-btn">Copy</button>
        </div>
      </div>
      <div class="result-body">
        <small>{labels[type].result}</small>
        <div class="result-number" id="result-number" aria-live="polite">0.00</div>
        <div class="result-unit" id="result-unit">kg</div>
        <p id="result-helper" data-default-helper={labels[type].helper}>{labels[type].helper}</p>
        <div class="result-detail">
          <div><span id="detail-one-label">Per item</span><strong id="detail-one-value">—</strong></div>
          <div><span id="detail-two-label">Quantity</span><strong id="detail-two-value">—</strong></div>
        </div>
      </div>
      <div class="result-secondary">
        <span id="secondary-label">Formula</span>
        <strong id="secondary-value" data-default-formula={formula}>{formula}</strong>
      </div>
    </aside>
  </section>

  <section class="calc-foot">
    <div><span class="foot-index">01</span><div><strong>Use the result as a planning estimate.</strong><p>Actual site weight and purchase cost can vary with grade, mill tolerances, coating, and supplier pricing.</p></div></div>
    <a href="/calculators">All calculators <span>↗</span></a>
  </section>

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="faq-heading">
      <div>
        <span class="form-kicker">QUICK ANSWERS</span>
        <h2 id="faq-title">Questions people ask.</h2>
      </div>
      <p>Keep these calculation assumptions in mind when you use the estimate for planning or procurement.</p>
    </div>
    <div class="faq-list">
      {currentFaqItems.map((item) => (
        <details>
          <summary>{item.question}<span aria-hidden="true">+</span></summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="related-section" aria-labelledby="related-title">
    <div>
      <span class="form-kicker">KEEP GOING</span>
      <h2 id="related-title">Related calculators.</h2>
    </div>
    <div class="related-grid">
      {currentRelatedTools.map((tool) => (
        <a href={tool.href}>{tool.title}<span aria-hidden="true">↗</span></a>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </main>

  <footer class="site-footer">
    <a class="brand footer-brand" href="/" aria-label="SteelCalc home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
    </a>
    <p>Practical steel estimates, without the extra steps.</p>
    <span>© {new Date().getFullYear()} SteelCalc</span>
  </footer>
</div>

<script>
  const root = document.querySelector('[data-calculator]');
  const form = root?.querySelector('#calc-form');
  const resultNumber = root?.querySelector('#result-number');
  const resultUnit = root?.querySelector('#result-unit');
  const resultHelper = root?.querySelector('#result-helper');
  const secondaryLabel = root?.querySelector('#secondary-label');
  const secondaryValue = root?.querySelector('#secondary-value');
  const detailOneLabel = root?.querySelector('#detail-one-label');
  const detailOneValue = root?.querySelector('#detail-one-value');
  const detailTwoLabel = root?.querySelector('#detail-two-label');
  const detailTwoValue = root?.querySelector('#detail-two-value');
  const copyBtn = root?.querySelector('#copy-btn');
  const shareBtn = root?.querySelector('#share-btn');
  const printBtn = root?.querySelector('#print-btn');
  const autoCalc = root?.querySelector('#auto-calc');
  const errorBox = root?.querySelector('#form-error');
  const resetBtn = root?.querySelector('#reset-btn');
  const type = root?.getAttribute('data-calculator');

  const value = (id) => Number(root?.querySelector('#' + id)?.value || 0);
  const formatNumber = (number, maximumFractionDigits = 3) =>
    number.toLocaleString('en-IN', { maximumFractionDigits });

  const setError = (message = '') => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.toggle('show', Boolean(message));
  };

  const requirePositive = (...pairs) => {
    const invalid = pairs.find(([, number]) => !Number.isFinite(number) || number <= 0);
    if (invalid) {
      setError(`Enter a positive value for ${invalid[0]}.`);
      return false;
    }
    setError();
    return true;
  };

  const setDetails = (oneLabel, oneValue, twoLabel, twoValue) => {
    if (!detailOneLabel || !detailOneValue || !detailTwoLabel || !detailTwoValue) return;
    detailOneLabel.textContent = oneLabel;
    detailOneValue.textContent = oneValue;
    detailTwoLabel.textContent = twoLabel;
    detailTwoValue.textContent = twoValue;
  };

  const setResult = (number, unit, helper, label, secondary, details = ['Detail', '—', 'Quantity', '—']) => {
    if (!resultNumber || !resultUnit || !resultHelper || !secondaryLabel || !secondaryValue) return;
    resultNumber.textContent = formatNumber(number);
    resultUnit.textContent = unit;
    resultHelper.textContent = helper;
    secondaryLabel.textContent = label;
    secondaryValue.textContent = secondary;
    setDetails(...details);
  };

  const clearResultDisplay = () => {
    if (!resultNumber || !resultUnit || !resultHelper || !secondaryLabel || !secondaryValue) return;
    resultNumber.textContent = '—';
    resultUnit.textContent = '';
    resultHelper.textContent = resultHelper.dataset.defaultHelper || '';
    secondaryLabel.textContent = 'Formula';
    secondaryValue.textContent = secondaryValue.dataset.defaultFormula || '';
    setDetails('Per item', '—', 'Quantity', '—');
  };

  const hasRequiredInputs = () => {
    if (!form) return false;
    const controls = Array.from(form.querySelectorAll('input[type="number"], select'))
      .filter((control) => control.id !== 'auto-calc')
      .filter((control) => control.id !== 'waste')
      .filter((control) => !control.closest('.field')?.classList.contains('hidden-field'));
    return controls.every((control) => control.value.trim() !== '');
  };

  const getSummaryText = () => {
    const heading = document.title.replace(' | SteelCalc', '');
    const primary = `${resultNumber?.textContent || '0.00'} ${resultUnit?.textContent || ''}`.trim();
    const formulaLine = `${secondaryLabel?.textContent || 'Formula'}: ${secondaryValue?.textContent || ''}`;
    const detailOne = `${detailOneLabel?.textContent || ''}: ${detailOneValue?.textContent || ''}`;
    const detailTwo = `${detailTwoLabel?.textContent || ''}: ${detailTwoValue?.textContent || ''}`;
    return [heading, primary, formulaLine, detailOne, detailTwo].join('\n');
  };

  const debounce = (callback, wait = 180) => {
    let timeout = 0;
    return (...args) => {
      window.clearTimeout(timeout);
      timeout = window.setTimeout(() => callback(...args), wait);
    };
  };

  const updateShapeFields = () => {
    if (type !== 'steel-weight') return;
    const shape = root?.querySelector('#shape')?.value;
    root?.querySelectorAll('.shape-round').forEach((el) => el.classList.toggle('hidden-field', shape !== 'round'));
    root?.querySelectorAll('.shape-square').forEach((el) => el.classList.toggle('hidden-field', shape !== 'square'));
    root?.querySelectorAll('.shape-rect').forEach((el) => el.classList.toggle('hidden-field', shape !== 'rect'));
    root?.querySelectorAll('.shape-flat').forEach((el) => el.classList.toggle('hidden-field', shape !== 'flat'));
    root?.querySelectorAll('.shape-hex').forEach((el) => el.classList.toggle('hidden-field', shape !== 'hex'));
  };

  const calculate = () => {
    if (!type) return;
    if (type === 'steel-weight') {
      const shape = root.querySelector('#shape').value;
      const density = value('density');
      const lengthM = value('length');
      const qty = value('quantity');
      let areaMm2 = 0;
      let shapeText = '';
      let detailText = '';
      if (shape === 'round') { const d = value('diameter'); if (!requirePositive(['Diameter', d], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = Math.PI * d * d / 4; shapeText = 'π × d² / 4 × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      if (shape === 'square') { const s = value('side'); if (!requirePositive(['Side', s], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = s * s; shapeText = 's² × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      if (shape === 'rect') { const w = value('width'); const t = value('thickness'); if (!requirePositive(['Width', w], ['Thickness', t], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = w * t; shapeText = 'W × T × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      if (shape === 'flat') { const w = value('flat-width'); const t = value('thickness'); if (!requirePositive(['Width', w], ['Thickness', t], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = w * t; shapeText = 'W × T × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      if (shape === 'hex') { const s = value('hex-side'); if (!requirePositive(['Side', s], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = 3 * Math.sqrt(3) / 2 * s * s; shapeText = '3√3 / 2 × s² × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      const kgPerPiece = areaMm2 / 1_000_000 * lengthM * density;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Calculated for the selected shape and quantity.', 'Formula', shapeText, ['Weight / piece', `${formatNumber(kgPerPiece)} kg`, 'Cross-section', detailText]);
      return;
    }
    if (type === 'tmt-rebar') {
      const d = value('diameter');
      const lengthM = value('length');
      const qty = value('quantity');
      if (!requirePositive(['Diameter', d], ['Length', lengthM], ['Quantity', qty])) return;
      const kgPerM = d * d / 162.2;
      const kgPerPiece = kgPerM * lengthM;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Uses the nominal d² / 162.2 steel weight relation.', 'Unit weight', `${formatNumber(kgPerM)} kg/m`, ['Weight / bar', `${formatNumber(kgPerPiece)} kg`, 'Bars', `${formatNumber(qty, 0)} pcs`]);
      return;
    }
    if (type === 'steel-plate') {
      const t = value('thickness');
      const w = value('width');
      const l = value('length');
      const qty = value('quantity');
      if (!requirePositive(['Thickness', t], ['Width', w], ['Length', l], ['Quantity', qty])) return;
      const kgPerPiece = t * w * l * 0.00000785;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Calculated using a nominal steel density of 7.85 g/cm³.', 'Formula', 'T × W × L × 0.00000785', ['Weight / sheet', `${formatNumber(kgPerPiece)} kg`, 'Sheets', `${formatNumber(qty, 0)} pcs`]);
      return;
    }
    if (type === 'steel-pipe') {
      const od = value('outer-diameter');
      const t = value('thickness');
      const lengthM = value('length');
      const qty = value('quantity');
      const density = value('density');
      const id = od - 2 * t;
      if (!requirePositive(['Outer diameter', od], ['Wall thickness', t], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return;
      if (id <= 0) { setError('Wall thickness must be less than half the outside diameter.'); return; }
      const areaMm2 = Math.PI / 4 * (od * od - id * id);
      const kgPerM = areaMm2 / 1_000_000 * density;
      const kgPerPiece = kgPerM * lengthM;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Calculated from annular cross-sectional area.', 'Inside diameter', `${formatNumber(id)} mm`, ['Weight / pipe', `${formatNumber(kgPerPiece)} kg`, 'Unit weight', `${formatNumber(kgPerM)} kg/m`]);
      return;
    }
    if (type === 'steel-cost') {
      const weight = value('weight');
      const rate = value('rate');
      const qty = value('quantity');
      const waste = value('waste');
      if (!requirePositive(['Weight', weight], ['Rate', rate], ['Quantity', qty])) return;
      if (!Number.isFinite(waste) || waste < 0) { setError('Waste / allowance cannot be negative.'); return; }
      const baseWeight = weight * qty;
      const adjustedWeight = baseWeight * (1 + waste / 100);
      const cost = adjustedWeight * rate;
      setResult(cost, '₹', 'Includes the entered quantity and optional waste/allowance.', 'Adjusted weight', `${formatNumber(adjustedWeight)} kg`, ['Base material', `₹${formatNumber(baseWeight * rate, 2)}`, 'Waste added', `${formatNumber(waste, 1)}%`]);
    }
    if (type === 'concrete') {
      const lengthM = value('length');
      const widthM = value('width');
      const depthM = value('depth');
      const qty = value('quantity');
      const dryFactor = value('dry-factor');
      const cementRatio = value('cement-ratio');
      const sandRatio = value('sand-ratio');
      const aggregateRatio = value('aggregate-ratio');
      const bagWeight = value('cement-bag');

      if (!requirePositive(
        ['Length', lengthM],
        ['Width', widthM],
        ['Depth / thickness', depthM],
        ['Quantity', qty],
        ['Dry volume factor', dryFactor],
        ['Cement ratio', cementRatio],
        ['Sand ratio', sandRatio],
        ['Aggregate ratio', aggregateRatio],
        ['Cement bag weight', bagWeight]
      )) return;

      const ratioTotal = cementRatio + sandRatio + aggregateRatio;
      if (ratioTotal <= 0) { setError('Mix ratio total must be greater than zero.'); return; }

      const wetVolume = lengthM * widthM * depthM * qty;
      const dryVolume = wetVolume * dryFactor;
      const cementVolume = dryVolume * cementRatio / ratioTotal;
      const sandVolume = dryVolume * sandRatio / ratioTotal;
      const aggregateVolume = dryVolume * aggregateRatio / ratioTotal;
      const cementMass = cementVolume * 1440;
      const bags = cementMass / bagWeight;
      const element = root.querySelector('#element')?.value || 'slab';

      setResult(
        wetVolume,
        'm³',
        `Estimated wet concrete volume for the selected ${element}.`,
        'Dry material volume',
        `${formatNumber(dryVolume)} m³`,
        [
          'Cement',
          `${formatNumber(bags)} bags`,
          'Sand / aggregate',
          `${formatNumber(sandVolume)} m³ / ${formatNumber(aggregateVolume)} m³`
        ]
      );
      return;
    }
    if (type === 'masonry') {
      const unitType = root.querySelector('#unit-type')?.value || '';
      const wallLength = value('wall-length');
      const wallHeight = value('wall-height');
      const wallThickness = value('wall-thickness');
      const unitLength = value('unit-length');
      const unitHeight = value('unit-height');
      const unitThickness = value('unit-thickness');
      const joint = value('joint');
      const dryMortarFactor = value('dry-mortar-factor');
      const cementRatio = value('cement-mortar-ratio');
      const sandRatio = value('sand-mortar-ratio');
      const bagWeight = value('cement-bag');
      const wastage = value('masonry-wastage');

      if (!unitType) { setError('Select the masonry unit.'); return; }
      if (!requirePositive(
        ['Wall length', wallLength],
        ['Wall height', wallHeight],
        ['Wall thickness', wallThickness],
        ['Unit length', unitLength],
        ['Unit height', unitHeight],
        ['Unit thickness', unitThickness],
        ['Dry mortar factor', dryMortarFactor],
        ['Cement ratio', cementRatio],
        ['Sand ratio', sandRatio],
        ['Cement bag weight', bagWeight]
      )) return;
      if (joint < 0) { setError('Mortar joint cannot be negative.'); return; }
      if (wastage < 0) { setError('Wastage cannot be negative.'); return; }

      const wallVolume = wallLength * wallHeight * (wallThickness / 1000);
      const moduleLength = (unitLength + joint) / 1000;
      const moduleHeight = (unitHeight + joint) / 1000;
      const moduleThickness = (unitThickness + joint) / 1000;
      const moduleVolume = moduleLength * moduleHeight * moduleThickness;
      const baseUnits = wallVolume / moduleVolume;
      const planningUnits = baseUnits * (1 + wastage / 100);
      const solidUnitVolume = (unitLength / 1000) * (unitHeight / 1000) * (unitThickness / 1000);
      const wetMortar = Math.max(0, wallVolume - (baseUnits * solidUnitVolume));
      const dryMortar = wetMortar * dryMortarFactor;
      const ratioTotal = cementRatio + sandRatio;
      if (ratioTotal <= 0) { setError('Mortar ratio total must be greater than zero.'); return; }
      const cementVolume = dryMortar * cementRatio / ratioTotal;
      const sandVolume = dryMortar * sandRatio / ratioTotal;
      const cementMass = cementVolume * 1440;
      const cementBags = cementMass / bagWeight;
      const unitName = unitType === 'block' ? 'blocks' : 'bricks';

      setResult(
        planningUnits,
        unitName,
        `Estimated masonry quantities for the selected ${unitType}.`,
        'Wet mortar',
        `${formatNumber(wetMortar)} m³`,
        [
          'Cement',
          `${formatNumber(cementBags)} bags`,
          'Sand',
          `${formatNumber(sandVolume)} m³`
        ]
      );
      return;
    }
  };

  const buildShareUrl = () => {
    if (!form) return window.location.href;
    const url = new URL(window.location.href);
    url.search = '';
    const params = new URLSearchParams();
    params.set('shared', '1');
    form.querySelectorAll('input[id], select[id]').forEach((field) => {
      const wrapper = field.closest('.field');
      if (wrapper?.classList.contains('hidden-field')) return;
      const value = field.value.trim();
      if (value) params.set(field.id, value);
    });
    url.search = params.toString();
    return url.toString();
  };

  const loadSharedInputs = () => {
    if (!form) return false;
    const params = new URLSearchParams(window.location.search);
    if (params.get('shared') !== '1') return false;
    let loaded = false;
    form.querySelectorAll('input[id], select[id]').forEach((field) => {
      const sharedValue = params.get(field.id);
      if (sharedValue !== null) {
        const option = field.tagName === 'SELECT'
          ? Array.from(field.options).find((item) => item.value === sharedValue)
          : true;
        if (option) {
          field.value = sharedValue;
          loaded = true;
        }
      }
    });
    return loaded;
  };

  form?.addEventListener('submit', (event) => { event.preventDefault(); calculate(); });
  const liveCalculate = debounce(() => {
    if (autoCalc?.checked) calculate();
  });

  form?.querySelectorAll('input, select').forEach((field) => {
    field.addEventListener('input', () => {
      setError();
      if (autoCalc?.checked && hasRequiredInputs()) liveCalculate();
      else if (!hasRequiredInputs()) clearResultDisplay();
    });
    field.addEventListener('change', () => {
      setError();
      if (autoCalc?.checked && hasRequiredInputs()) calculate();
      else if (!hasRequiredInputs()) clearResultDisplay();
    });
  });

  autoCalc?.addEventListener('change', () => {
    if (autoCalc.checked) calculate();
  });
  root?.querySelector('#shape')?.addEventListener('change', () => {
    updateShapeFields();
    setError();
    if (autoCalc?.checked && hasRequiredInputs()) calculate();
    else clearResultDisplay();
  });

  resetBtn?.addEventListener('click', () => {
    form?.querySelectorAll('input[type="number"]').forEach((field) => {
      field.value = '';
    });
    form?.querySelectorAll('select').forEach((select) => {
      select.selectedIndex = 0;
    });
    if (autoCalc) autoCalc.checked = true;
    window.history.replaceState({}, '', window.location.pathname);
    setError();
    updateShapeFields();
    clearResultDisplay();
  });
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(getSummaryText());
      copyBtn.textContent = 'Copied';
      setTimeout(() => copyBtn.textContent = 'Copy', 1100);
    } catch {
      setError('Copy is not available in this browser.');
    }
  });

  printBtn?.addEventListener('click', () => {
    window.print();
  });
  shareBtn?.addEventListener('click', async () => {
    const url = buildShareUrl();
    const shareData = {
      title: document.title,
      text: `SteelCalc result: ${resultNumber?.textContent || ''} ${resultUnit?.textContent || ''}`,
      url
    };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
        return;
      }
      await navigator.clipboard.writeText(url);
      shareBtn.textContent = 'Link copied';
      setTimeout(() => shareBtn.textContent = 'Share', 1300);
    } catch (error) {
      if (error?.name === 'AbortError') return;
      setError('Unable to create a share link in this browser.');
    }
  });

  const loadedSharedInputs = loadSharedInputs();
  updateShapeFields();
  if (loadedSharedInputs && hasRequiredInputs()) calculate();
  else clearResultDisplay();
</script>

