---
interface Props {
  type: 'steel-weight' | 'tmt-rebar' | 'steel-plate' | 'steel-pipe' | 'steel-cost';
  eyebrow: string;
  title: string;
  accent: string;
  description: string;
  formula: string;
}

const { type, eyebrow, title, accent, description, formula } = Astro.props;
const labels: Record<Props['type'], { result: string; helper: string }> = {
  'steel-weight': { result: 'Estimated weight', helper: 'Based on steel density and entered dimensions.' },
  'tmt-rebar': { result: 'Total rebar weight', helper: 'Uses the standard d² / 162 kg-per-metre method.' },
  'steel-plate': { result: 'Plate weight', helper: 'Calculated using 7.85 g/cm³ steel density.' },
  'steel-pipe': { result: 'Pipe weight', helper: 'Based on outside diameter, wall thickness, and length.' },
  'steel-cost': { result: 'Estimated material cost', helper: 'Weight × rate, with an optional allowance for waste.' },
};
---

<div class="calculator-page" data-calculator={type}>
  <div class="calc-crumb">
    <a href="/">SteelCalc</a><span>/</span><span>Calculator</span>
  </div>

  <section class="calc-hero">
    <div>
      <div class="eyebrow"><span class="status-dot"></span>{eyebrow}</div>
      <h1>{title} <em>{accent}</em></h1>
      <p>{description}</p>
    </div>
    <div class="hero-chip">
      <span>LIVE</span>
      <strong>Instant result</strong>
      <small>No sign-up. No spreadsheet needed.</small>
    </div>
  </section>

  <section class="calculator-card">
    <form class="calc-form" id="calc-form">
      <div class="form-head">
        <div><span class="form-kicker">INPUTS</span><h2>Enter your dimensions</h2></div>
        <button class="ghost-btn" type="button" id="reset-btn">Reset</button>
      </div>
      <div id="form-error" role="alert" aria-live="polite"></div>

      {type === 'steel-weight' && (
        <>
          <div class="field full"><label for="shape">Shape</label><select id="shape"><option value="round">Round bar</option><option value="square">Square bar</option><option value="rect">Rectangular bar</option></select></div>
          <div class="field shape-round"><label for="diameter">Diameter <span>mm</span></label><input id="diameter" type="number" min="0" step="0.01" value="20" /></div>
          <div class="field shape-square"><label for="side">Side <span>mm</span></label><input id="side" type="number" min="0" step="0.01" value="20" /></div>
          <div class="field shape-rect"><label for="width">Width <span>mm</span></label><input id="width" type="number" min="0" step="0.01" value="40" /></div>
          <div class="field shape-rect"><label for="thickness">Thickness <span>mm</span></label><input id="thickness" type="number" min="0" step="0.01" value="6" /></div>
          <div class="field"><label for="length">Length <span>m</span></label><input id="length" type="number" min="0" step="0.01" value="6" /></div>
          <div class="field"><label for="quantity">Quantity <span>pcs</span></label><input id="quantity" type="number" min="1" step="1" value="1" /></div>
          <div class="field"><label for="density">Density <span>kg/m³</span></label><input id="density" type="number" min="1" step="1" value="7850" /></div>
        </>
      )}

      {type === 'tmt-rebar' && (
        <>
          <div class="field full"><label for="diameter">Bar diameter <span>mm</span></label><select id="diameter"><option>6</option><option>8</option><option>10</option><option>12</option><option selected>16</option><option>20</option><option>25</option><option>28</option><option>32</option><option>36</option><option>40</option></select></div>
          <div class="field"><label for="length">Length per bar <span>m</span></label><input id="length" type="number" min="0" step="0.01" value="12" /></div>
          <div class="field"><label for="quantity">Number of bars <span>pcs</span></label><input id="quantity" type="number" min="1" step="1" value="10" /></div>
        </>
      )}

      {type === 'steel-plate' && (
        <>
          <div class="field"><label for="thickness">Thickness <span>mm</span></label><input id="thickness" type="number" min="0" step="0.01" value="6" /></div>
          <div class="field"><label for="width">Width <span>mm</span></label><input id="width" type="number" min="0" step="0.01" value="1220" /></div>
          <div class="field"><label for="length">Length <span>mm</span></label><input id="length" type="number" min="0" step="0.01" value="2440" /></div>
          <div class="field"><label for="quantity">Quantity <span>sheets</span></label><input id="quantity" type="number" min="1" step="1" value="1" /></div>
        </>
      )}

      {type === 'steel-pipe' && (
        <>
          <div class="field"><label for="outer-diameter">Outer diameter <span>mm</span></label><input id="outer-diameter" type="number" min="0" step="0.01" value="60.3" /></div>
          <div class="field"><label for="thickness">Wall thickness <span>mm</span></label><input id="thickness" type="number" min="0" step="0.01" value="3.2" /></div>
          <div class="field"><label for="length">Length <span>m</span></label><input id="length" type="number" min="0" step="0.01" value="6" /></div>
          <div class="field"><label for="quantity">Quantity <span>pcs</span></label><input id="quantity" type="number" min="1" step="1" value="1" /></div>
          <div class="field full"><label for="density">Density <span>kg/m³</span></label><input id="density" type="number" min="1" step="1" value="7850" /></div>
        </>
      )}

      {type === 'steel-cost' && (
        <>
          <div class="field"><label for="weight">Weight <span>kg</span></label><input id="weight" type="number" min="0" step="0.01" value="100" /></div>
          <div class="field"><label for="rate">Rate <span>₹ / kg</span></label><input id="rate" type="number" min="0" step="0.01" value="75" /></div>
          <div class="field"><label for="quantity">Quantity <span>lots</span></label><input id="quantity" type="number" min="1" step="1" value="1" /></div>
          <div class="field"><label for="waste">Waste / allowance <span>%</span></label><input id="waste" type="number" min="0" step="0.1" value="0" /></div>
        </>
      )}

      <div class="form-actions full">
        <button class="calculate-btn" type="submit">Calculate <span>→</span></button>
        <span class="keyboard-note">Press <kbd>Enter</kbd> to calculate</span>
      </div>
    </form>

    <aside class="result-panel">
      <div class="result-top"><span>RESULT</span><button type="button" id="copy-btn" class="copy-btn">Copy</button></div>
      <div class="result-body">
        <small>{labels[type].result}</small>
        <div class="result-number" id="result-number" aria-live="polite">0.00</div>
        <div class="result-unit" id="result-unit">kg</div>
        <p id="result-helper">{labels[type].helper}</p>
        <div class="result-detail">
          <div><span id="detail-one-label">Per item</span><strong id="detail-one-value">—</strong></div>
          <div><span id="detail-two-label">Quantity</span><strong id="detail-two-value">—</strong></div>
        </div>
      </div>
      <div class="result-secondary">
        <span id="secondary-label">Formula</span>
        <strong id="secondary-value">{formula}</strong>
      </div>
    </aside>
  </section>

  <section class="calc-foot">
    <div><span class="foot-index">01</span><div><strong>Use the result as a planning estimate.</strong><p>Actual site weight and purchase cost can vary with grade, mill tolerances, coating, and supplier pricing.</p></div></div>
    <a href="/#tools">Back to all calculators <span>↗</span></a>
  </section>
</div>

<script>
  const root = document.querySelector('[data-calculator]');
  const form = root?.querySelector('#calc-form');
  const resultNumber = root?.querySelector('#result-number');
  const resultUnit = root?.querySelector('#result-unit');
  const resultHelper = root?.querySelector('#result-helper');
  const secondaryLabel = root?.querySelector('#secondary-label');
  const secondaryValue = root?.querySelector('#secondary-value');
  const detailOneLabel = root?.querySelector('#detail-one-label');
  const detailOneValue = root?.querySelector('#detail-one-value');
  const detailTwoLabel = root?.querySelector('#detail-two-label');
  const detailTwoValue = root?.querySelector('#detail-two-value');
  const copyBtn = root?.querySelector('#copy-btn');
  const errorBox = root?.querySelector('#form-error');
  const resetBtn = root?.querySelector('#reset-btn');
  const type = root?.getAttribute('data-calculator');

  const value = (id) => Number(root?.querySelector('#' + id)?.value || 0);
  const formatNumber = (number, maximumFractionDigits = 3) =>
    number.toLocaleString('en-IN', { maximumFractionDigits });

  const setError = (message = '') => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.toggle('show', Boolean(message));
  };

  const requirePositive = (...pairs) => {
    const invalid = pairs.find(([, number]) => !Number.isFinite(number) || number <= 0);
    if (invalid) {
      setError(`Enter a positive value for ${invalid[0]}.`);
      return false;
    }
    setError();
    return true;
  };

  const setDetails = (oneLabel, oneValue, twoLabel, twoValue) => {
    if (!detailOneLabel || !detailOneValue || !detailTwoLabel || !detailTwoValue) return;
    detailOneLabel.textContent = oneLabel;
    detailOneValue.textContent = oneValue;
    detailTwoLabel.textContent = twoLabel;
    detailTwoValue.textContent = twoValue;
  };

  const setResult = (number, unit, helper, label, secondary, details = ['Detail', '—', 'Quantity', '—']) => {
    if (!resultNumber || !resultUnit || !resultHelper || !secondaryLabel || !secondaryValue) return;
    resultNumber.textContent = formatNumber(number);
    resultUnit.textContent = unit;
    resultHelper.textContent = helper;
    secondaryLabel.textContent = label;
    secondaryValue.textContent = secondary;
    setDetails(...details);
  };

  const updateShapeFields = () => {
    if (type !== 'steel-weight') return;
    const shape = root?.querySelector('#shape')?.value;
    root?.querySelectorAll('.shape-round').forEach((el) => el.classList.toggle('hidden-field', shape !== 'round'));
    root?.querySelectorAll('.shape-square').forEach((el) => el.classList.toggle('hidden-field', shape !== 'square'));
    root?.querySelectorAll('.shape-rect').forEach((el) => el.classList.toggle('hidden-field', shape !== 'rect'));
  };

  const calculate = () => {
    if (!type) return;
    if (type === 'steel-weight') {
      const shape = root.querySelector('#shape').value;
      const density = value('density');
      const lengthM = value('length');
      const qty = value('quantity');
      let areaMm2 = 0;
      let shapeText = '';
      let detailText = '';
      if (shape === 'round') { const d = value('diameter'); if (!requirePositive(['Diameter', d], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = Math.PI * d * d / 4; shapeText = 'π × d² / 4 × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      if (shape === 'square') { const s = value('side'); if (!requirePositive(['Side', s], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = s * s; shapeText = 's² × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      if (shape === 'rect') { const w = value('width'); const t = value('thickness'); if (!requirePositive(['Width', w], ['Thickness', t], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return; areaMm2 = w * t; shapeText = 'W × T × L × ρ'; detailText = `${formatNumber(areaMm2)} mm²`; }
      const kgPerPiece = areaMm2 / 1_000_000 * lengthM * density;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Calculated for the selected shape and quantity.', 'Formula', shapeText, ['Weight / piece', `${formatNumber(kgPerPiece)} kg`, 'Cross-section', detailText]);
      return;
    }
    if (type === 'tmt-rebar') {
      const d = value('diameter');
      const lengthM = value('length');
      const qty = value('quantity');
      if (!requirePositive(['Diameter', d], ['Length', lengthM], ['Quantity', qty])) return;
      const kgPerM = d * d / 162;
      const kgPerPiece = kgPerM * lengthM;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Uses the standard nominal TMT/rebar weight relation.', 'Unit weight', `${formatNumber(kgPerM)} kg/m`, ['Weight / bar', `${formatNumber(kgPerPiece)} kg`, 'Bars', `${formatNumber(qty, 0)} pcs`]);
      return;
    }
    if (type === 'steel-plate') {
      const t = value('thickness');
      const w = value('width');
      const l = value('length');
      const qty = value('quantity');
      if (!requirePositive(['Thickness', t], ['Width', w], ['Length', l], ['Quantity', qty])) return;
      const kgPerPiece = t * w * l * 0.00000785;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Calculated using a nominal steel density of 7.85 g/cm³.', 'Formula', 'T × W × L × 0.00000785', ['Weight / sheet', `${formatNumber(kgPerPiece)} kg`, 'Sheets', `${formatNumber(qty, 0)} pcs`]);
      return;
    }
    if (type === 'steel-pipe') {
      const od = value('outer-diameter');
      const t = value('thickness');
      const lengthM = value('length');
      const qty = value('quantity');
      const density = value('density');
      const id = od - 2 * t;
      if (!requirePositive(['Outer diameter', od], ['Wall thickness', t], ['Length', lengthM], ['Quantity', qty], ['Density', density])) return;
      if (id <= 0) { setError('Wall thickness must be less than half the outside diameter.'); return; }
      const areaMm2 = Math.PI / 4 * (od * od - id * id);
      const kgPerM = areaMm2 / 1_000_000 * density;
      const kgPerPiece = kgPerM * lengthM;
      const kg = kgPerPiece * qty;
      setResult(kg, 'kg', 'Calculated from annular cross-sectional area.', 'Inside diameter', `${formatNumber(id)} mm`, ['Weight / pipe', `${formatNumber(kgPerPiece)} kg`, 'Unit weight', `${formatNumber(kgPerM)} kg/m`]);
      return;
    }
    if (type === 'steel-cost') {
      const weight = value('weight');
      const rate = value('rate');
      const qty = value('quantity');
      const waste = value('waste');
      if (!requirePositive(['Weight', weight], ['Rate', rate], ['Quantity', qty])) return;
      if (!Number.isFinite(waste) || waste < 0) { setError('Waste / allowance cannot be negative.'); return; }
      const baseWeight = weight * qty;
      const adjustedWeight = baseWeight * (1 + waste / 100);
      const cost = adjustedWeight * rate;
      setResult(cost, '₹', 'Includes the entered quantity and optional waste/allowance.', 'Adjusted weight', `${formatNumber(adjustedWeight)} kg`, ['Base material', `₹${formatNumber(baseWeight * rate, 2)}`, 'Waste added', `${formatNumber(waste, 1)}%`]);
    }
  };

  form?.addEventListener('submit', (event) => { event.preventDefault(); calculate(); });
  form?.querySelectorAll('input, select').forEach((field) => {
    field.addEventListener('input', () => setError());
    field.addEventListener('change', () => setError());
  });
  root?.querySelector('#shape')?.addEventListener('change', () => { updateShapeFields(); calculate(); });
  resetBtn?.addEventListener('click', () => { form?.reset(); updateShapeFields(); calculate(); });
  copyBtn?.addEventListener('click', async () => {
    const text = (resultNumber?.textContent || '') + ' ' + (resultUnit?.textContent || '');
    try { await navigator.clipboard.writeText(text); copyBtn.textContent = 'Copied'; setTimeout(() => copyBtn.textContent = 'Copy', 1100); } catch {}
  });
  updateShapeFields();
  calculate();
</script>

<style>
  :global(body){background:#f6f7f8;color:#17212b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
  .calculator-page{max-width:1180px;margin:0 auto;padding:0 28px 72px}
  .calc-crumb{display:flex;gap:10px;align-items:center;padding:22px 0;font-size:10px;color:#929ca4}
  .calc-crumb a{color:#66727d;text-decoration:none;font-weight:700}.calc-crumb span:nth-child(2){color:#cad0d5}
  .calc-hero{display:flex;justify-content:space-between;align-items:flex-end;gap:35px;padding:52px 0 42px}
  .eyebrow{font-size:9px;font-weight:800;letter-spacing:2px;color:#8a949d;display:flex;align-items:center;gap:9px}
  .status-dot{width:6px;height:6px;background:#e6a13a;border-radius:50%;box-shadow:0 0 0 4px #f7ead7}
  .calc-hero h1{font-size:clamp(40px,5vw,62px);line-height:1.04;letter-spacing:-3.3px;margin:20px 0 14px;font-weight:780;color:#17212b}.calc-hero h1 em{font-family:Georgia,serif;font-weight:500;color:#c88427}.calc-hero p{max-width:630px;margin:0;color:#6e7983;font-size:13px;line-height:1.8}
  .hero-chip{min-width:220px;border:1px solid #dce1e5;background:#fff;border-radius:9px;padding:16px 18px;box-shadow:0 8px 24px #17212b08}.hero-chip span{font-size:7px;font-weight:850;letter-spacing:1.5px;color:#5f8862}.hero-chip strong{display:block;font-size:12px;color:#25313b;margin:5px 0 3px}.hero-chip small{font-size:9px;color:#939da5}
  .calculator-card{display:grid;grid-template-columns:1.08fr .92fr;border:1px solid #dce2e6;border-radius:11px;background:#fff;box-shadow:0 18px 40px #1c2a3408;overflow:hidden}
.calc-form{padding:28px}.form-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px}
  #form-error{display:none;grid-column:1/-1;border:1px solid #e7caca;background:#fff6f6;color:#a44949;font-size:9px;line-height:1.5;padding:10px 11px;border-radius:6px}
  #form-error.show{display:block}.form-kicker{font-size:7px;font-weight:850;letter-spacing:1.5px;color:#c88427}.form-head h2{font-size:20px;letter-spacing:-.7px;margin:7px 0 0;color:#1b2731}.ghost-btn,.copy-btn{background:#f6f7f8;border:1px solid #e0e4e7;color:#707b84;font-weight:750;font-size:9px;padding:9px 11px;border-radius:6px;cursor:pointer}.ghost-btn:hover,.copy-btn:hover{border-color:#c6a26e;color:#293640}
  .calc-form{display:grid;grid-template-columns:1fr 1fr;gap:15px}.form-head,.form-actions{grid-column:1/-1}
  .field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field.hidden-field{display:none}.field label{font-size:9px;letter-spacing:.4px;font-weight:750;color:#5f6b75}.field label span{float:right;color:#a0a8ae;font-weight:650}.field input,.field select{height:44px;width:100%;border:1px solid #d9dfe3;background:#fbfcfc;border-radius:6px;padding:0 12px;font-size:12px;color:#20303a;outline:none;box-sizing:border-box}.field input:focus,.field select:focus{border-color:#d1a25f;box-shadow:0 0 0 3px #f6e9d4}.form-actions{display:flex;align-items:center;gap:13px;margin-top:5px}.calculate-btn{border:0;background:#17232e;color:#fff;font-size:11px;font-weight:800;padding:13px 18px;border-radius:6px;cursor:pointer;box-shadow:0 7px 14px #17232e14}.calculate-btn span{color:#efad4a;margin-left:17px;font-size:15px}.keyboard-note{font-size:9px;color:#99a1a8}.keyboard-note kbd{font-family:inherit;border:1px solid #d9dee2;border-bottom-width:2px;border-radius:3px;padding:1px 4px;background:#f6f7f8}
  .result-panel{background:#18252f;color:#fff;display:flex;flex-direction:column;min-height:100%;padding:27px}.result-top{display:flex;justify-content:space-between;align-items:center}.result-top>span{font-size:7px;letter-spacing:1.8px;font-weight:850;color:#aeb9c1}.copy-btn{background:#22333f;color:#b8c3ca;border-color:#334650}.result-body{padding:58px 0 48px}.result-body small{font-size:10px;color:#aab5bd}.result-number{font-size:clamp(42px,5vw,64px);letter-spacing:-3px;font-weight:720;line-height:1.05;margin-top:9px;color:#fff;word-break:break-word}.result-unit{font-size:11px;font-weight:800;color:#e2a04a;margin-top:5px}.result-body p{max-width:260px;color:#8e9ba4;font-size:9px;line-height:1.7;margin-top:21px}.result-secondary{margin-top:auto;border-top:1px solid #2c3a44;padding-top:16px}.result-secondary span{display:block;font-size:7px;letter-spacing:1.2px;color:#7e8b94;font-weight:800}.result-secondary strong{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;color:#bbc6cc;font-weight:500;margin-top:7px}
  .calc-foot{display:flex;justify-content:space-between;align-items:center;gap:30px;border-top:1px solid #dfe4e7;margin-top:34px;padding-top:22px}.calc-foot>div{display:flex;gap:12px;max-width:720px}.foot-index{font-family:Georgia,serif;font-size:18px;color:#c88427}.calc-foot strong{font-size:10px;color:#44515b}.calc-foot p{font-size:9px;line-height:1.65;color:#8e989f;margin:5px 0 0}.calc-foot>a{font-size:10px;font-weight:750;color:#606d77;text-decoration:none;white-space:nowrap}.calc-foot>a span{color:#c88427;margin-left:7px}
  @media(min-width:821px){.result-panel{position:sticky;top:18px;align-self:start}}
  @media(max-width:820px){.calc-hero{display:block}.hero-chip{margin-top:22px;max-width:260px}.calculator-card{grid-template-columns:1fr}.result-panel{min-height:330px}.calc-foot{align-items:flex-start;flex-direction:column}}
  @media(max-width:540px){.calculator-page{padding:0 18px 50px}.calc-hero{padding:36px 0 28px}.calc-hero h1{font-size:43px;letter-spacing:-2.5px}.calc-form{grid-template-columns:1fr;padding:22px}.form-head,.form-actions,.field.full{grid-column:auto}.field.full{display:flex}.form-head{grid-column:1/-1}.form-actions{grid-column:1/-1;align-items:flex-start;flex-direction:column}.result-panel{padding:23px}.result-number{font-size:48px}.calc-foot>a{white-space:normal}}
</style>
