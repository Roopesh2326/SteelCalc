---
import Layout from '../../layouts/Layout.astro';

const calculators = [
  {
    number: '01',
    title: 'Steel Weight Calculator',
    description: 'Calculate weight of common steel sections from dimensions, length, quantity, and density.',
    href: '/calculators/steel-weight',
    tag: 'WEIGHT',
    visual: 'weight'
  },
  {
    number: '02',
    title: 'TMT Rebar Calculator',
    description: 'Find the weight of TMT bars using diameter, length per bar, and quantity.',
    href: '/calculators/tmt-rebar',
    tag: 'REBAR',
    visual: 'rebar'
  },
  {
    number: '03',
    title: 'Steel Plate Calculator',
    description: 'Calculate plate weight from thickness, width, length, and sheet quantity.',
    href: '/calculators/steel-plate',
    tag: 'PLATE',
    visual: 'plate'
  },
  {
    number: '04',
    title: 'Steel Pipe Calculator',
    description: 'Calculate steel pipe weight from diameter, wall thickness, length, and density.',
    href: '/calculators/steel-pipe',
    tag: 'PIPE',
    visual: 'pipe'
  },
  {
    number: '05',
    title: 'Steel Cost Calculator',
    description: 'Estimate material cost from weight, rate per kg, quantity, and allowance.',
    href: '/calculators/steel-cost',
    tag: 'COST',
    visual: 'cost'
  }
];
---

<Layout
  title="Steel Calculators | SteelCalc"
  description="Explore SteelCalc's free steel weight, TMT rebar, steel plate, steel pipe, and steel cost calculators."
>
  <div class="site-shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="SteelCalc home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
      </a>

      <nav aria-label="Main navigation">
        <a class="active" href="/calculators">Calculators</a>
        <a href="/guides">Guides</a>
        <a href="/#how-it-works">About</a>
      </nav>

      <form class="header-search" action="/calculators" role="search">
        <span aria-hidden="true">⌕</span>
        <input name="q" type="search" value="" placeholder="Search calculators..." aria-label="Search calculators" autocomplete="off" />
      </form>

      <div class="header-tools" aria-hidden="true">
        <span>☾</span>
        <span>☼</span>
      </div>

      <a class="nav-cta" href="/calculators">All calculators <span aria-hidden="true">→</span></a>
    </header>

    <main>
      <div class="crumbs" aria-label="Breadcrumb">
        <a href="/">SteelCalc</a><span>/</span><strong>Calculators</strong>
      </div>

      <section class="directory-hero">
        <div>
          <div class="eyebrow">FREE ONLINE TOOLS</div>
          <h1>Our Steel <em>Calculators</em></h1>
          <p>Choose the tool that matches the steel material you're working with. Enter familiar measurements and get a practical estimate in seconds.</p>
        </div>

        <div class="hero-panel">
          <strong>05</strong>
          <span>Calculators</span>
          <small>Weight · Rebar · Plate · Pipe · Cost</small>
        </div>
      </section>

      <section class="directory-bar" aria-label="Calculator search and summary">
        <label class="search-box">
          <span aria-hidden="true">⌕</span>
          <input id="calculator-search" type="search" placeholder="Search calculators..." autocomplete="off" />
        </label>

        <div class="directory-stats">
          <span><strong>05</strong> tools</span>
          <span>Instant results</span>
          <span>No sign-up</span>
        </div>
      </section>

      <section class="tool-grid" id="calculator-grid" aria-label="Steel calculator directory">
        {calculators.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <div class="tool-card-top">
              <span class="tool-number">{tool.number}</span>
              <span class="tool-tag">{tool.tag}</span>
            </div>

            <div class={`tool-image ${tool.visual}`} aria-hidden="true">
              {tool.visual === 'weight' && <div class="art-weight"><span></span><span></span><span></span></div>}
              {tool.visual === 'rebar' && <div class="art-rebar"><span></span><span></span><span></span><span></span></div>}
              {tool.visual === 'plate' && <div class="art-plate"><span></span><span></span><span></span></div>}
              {tool.visual === 'pipe' && <div class="art-pipe"><span></span><i></i></div>}
              {tool.visual === 'cost' && <div class="art-cost"><span></span><b>₹</b><i></i></div>}
            </div>

            <h2>{tool.title}</h2>
            <p>{tool.description}</p>

            <div class="tool-card-bottom">
              <span>OPEN CALCULATOR</span>
              <b aria-hidden="true">→</b>
            </div>
          </a>
        ))}
      </section>

      <p class="no-results" id="no-results" hidden>No calculator matches that search. Try “pipe”, “rebar”, “plate”, “cost”, or “weight”.</p>

      <section class="guide" id="guide">
        <div class="guide-intro">
          <div class="eyebrow">HOW IT WORKS</div>
          <h2>Measure. Calculate.<br /><em>Move forward.</em></h2>
          <p>Use familiar dimensions, get an instant estimate, and keep the result handy for your next step.</p>
        </div>

        <div class="steps">
          <div><span>01</span><section><h3>Choose a calculator</h3><p>Start with the steel form that matches your material.</p></section></div>
          <div><span>02</span><section><h3>Enter your measurements</h3><p>Use the units shown beside each input field.</p></section></div>
          <div><span>03</span><section><h3>Review and share</h3><p>Copy, print, or share the calculation whenever you need it.</p></section></div>
        </div>
      </section>

      <section class="estimate-note">
        <div>
          <strong>About the estimates</strong>
          <p>SteelCalc provides calculation-based estimates. Actual purchased weight or cost can vary because of grade, manufacturing tolerances, coating, supplier pricing, and project-specific specifications.</p>
        </div>
        <a href="/">Back to home <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer>
      <div class="footer-brand-wrap">
        <a class="brand footer-brand" href="/" aria-label="SteelCalc home">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
        </a>
        <p>Free online steel calculators for weight, rebar, plate, pipe, and cost analysis.</p>
      </div>

      <div class="footer-col">
        <strong>Calculators</strong>
        <a href="/calculators/steel-weight">Steel Weight</a>
        <a href="/calculators/tmt-rebar">TMT Rebar</a>
        <a href="/calculators/steel-plate">Steel Plate</a>
      </div>

      <div class="footer-col">
        <strong>More Tools</strong>
        <a href="/calculators/steel-pipe">Steel Pipe</a>
        <a href="/calculators/steel-cost">Steel Cost</a>
        <a href="/calculators">All calculators</a>
      </div>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} SteelCalc. All rights reserved.</span>
        <span>Built for engineers, students, and builders.</span>
      </div>
    </footer>
  </div>
</Layout>

<script>
  const search = document.querySelector('#calculator-search');
  const headerSearch = document.querySelector('.header-search input');
  const cards = Array.from(document.querySelectorAll('.tool-card'));
  const noResults = document.querySelector('#no-results');

  const applyFilter = (value) => {
    const query = value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const text = card.textContent?.toLowerCase() || '';
      const match = !query || text.includes(query);
      card.toggleAttribute('hidden', !match);
      if (match) visible += 1;
    });

    if (noResults) noResults.hidden = visible > 0;
  };

  const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
  if (search) search.value = initialQuery;
  if (headerSearch) headerSearch.value = initialQuery;
  applyFilter(initialQuery);

  const syncSearch = (value) => {
    const query = value.trim();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    if (search) search.value = query;
    if (headerSearch) headerSearch.value = query;
    applyFilter(query);
  };

  search?.addEventListener('input', () => syncSearch(search.value));
  headerSearch?.addEventListener('input', () => syncSearch(headerSearch.value));
</script>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#f7f8f9;color:#17212b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}

  .site-shell{max-width:1460px;margin:0 auto;padding:0 5.8%}
  .topbar{height:82px;display:flex;align-items:center;gap:28px;border-bottom:1px solid #e4e7e9}
  .brand{display:flex;align-items:center;gap:9px;text-decoration:none;color:#18232d;font-size:19px;font-weight:850;letter-spacing:-.8px;line-height:1;margin-right:auto}
  .brand-light{font-weight:450;color:#68747e}
  .brand small{display:block;font-size:6.5px;letter-spacing:1.8px;font-weight:800;color:#8c969f;margin-top:5px}
  .brand-mark{width:29px;height:29px;background:#eca43c;border-radius:8px;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:6px}
  .brand-mark span{display:block;width:4px;background:#17212b;border-radius:1px}
  .brand-mark span:nth-child(1){height:8px}.brand-mark span:nth-child(2){height:13px}.brand-mark span:nth-child(3){height:10px}

  .topbar nav{display:flex;gap:28px}
  .topbar nav a{font-size:10px;font-weight:700;color:#56636d;text-decoration:none}
  .topbar nav a:hover,.topbar nav a.active{color:#17212b}

  .header-search{display:flex;align-items:center;gap:8px;width:190px;height:34px;border:1px solid #dde2e6;background:#fff;border-radius:7px;padding:0 10px}
  .header-search span{font-size:15px;color:#929ca4}
  .header-search input{width:100%;border:0;outline:0;background:transparent;font:inherit;font-size:8px;color:#25323b}
  .header-search input::placeholder{color:#a1aab1}

  .header-tools{display:flex;gap:9px;color:#7f8a92;font-size:13px}
  .header-tools span:last-child{color:#e5a03a}

  .nav-cta{font-size:9px;font-weight:800;color:#fff;text-decoration:none;background:#d9932f;padding:10px 12px;border-radius:6px;white-space:nowrap;box-shadow:0 5px 12px #d9932f22}
  .nav-cta span{margin-left:7px}

  .crumbs{display:flex;gap:8px;align-items:center;padding:20px 0 10px;font-size:8px;color:#9aa3aa}
  .crumbs a{color:#68737c;text-decoration:none;font-weight:700}
  .crumbs span{color:#ccd2d6}
  .crumbs strong{font-weight:750;color:#77838c}

  .directory-hero{display:grid;grid-template-columns:1fr 250px;gap:40px;align-items:end;padding:40px 0 32px}
  .eyebrow{font-size:7px;font-weight:850;letter-spacing:1.8px;color:#8b959d}
  .directory-hero h1{font-size:clamp(42px,5vw,63px);line-height:1.02;letter-spacing:-3.5px;margin:17px 0 15px;font-weight:790;color:#17212b}
  .directory-hero h1 em,.guide h2 em{font-family:Georgia,serif;font-weight:500;color:#dc942d}
  .directory-hero p{max-width:660px;font-size:11px;line-height:1.8;color:#64717b;margin:0}

  .hero-panel{border:1px solid #dfe4e7;background:#fff;border-radius:7px;padding:18px 19px;box-shadow:0 8px 20px #1f2d3708}
  .hero-panel strong{display:block;font-family:Georgia,serif;color:#c88529;font-size:28px;font-weight:500}
  .hero-panel span{display:block;color:#27333c;font-size:10px;font-weight:800;margin-top:4px}
  .hero-panel small{display:block;color:#89949c;font-size:7px;line-height:1.6;margin-top:4px}

  .directory-bar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:15px}
  .search-box{display:flex;align-items:center;gap:8px;width:330px;height:38px;border:1px solid #dde2e6;background:#fff;border-radius:7px;padding:0 11px;box-shadow:0 5px 14px #17232d07}
  .search-box span{font-size:15px;color:#9aa3aa}
  .search-box input{width:100%;border:0;outline:0;background:transparent;font:inherit;font-size:9px;color:#25323b}
  .search-box input::placeholder{color:#a4adb4}

  .directory-stats{display:flex;align-items:center;gap:13px;font-size:8px;color:#8c969e}
  .directory-stats span{padding-left:13px;border-left:1px solid #e0e5e8}
  .directory-stats span:first-child{padding-left:0;border-left:0}
  .directory-stats strong{font-family:Georgia,serif;color:#c4862c;font-size:14px;margin-right:4px}

  .tool-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px}
  .tool-card{display:flex;flex-direction:column;min-width:0;min-height:250px;background:#fff;border:1px solid #e1e5e8;border-radius:6px;padding:12px 12px 11px;box-shadow:0 5px 15px #17232d05;transition:transform .18s,border-color .18s,box-shadow .18s;text-decoration:none;color:inherit}
  .tool-card:hover{transform:translateY(-3px);border-color:#d7b576;box-shadow:0 13px 27px #17232d0b}
  .tool-card[hidden]{display:none}
  .tool-card-top{display:flex;justify-content:space-between;align-items:center}
  .tool-number{font-size:7px;font-weight:850;color:#cb892a}
  .tool-tag{font-size:5.5px;letter-spacing:1px;color:#929ba2;background:#f3f5f6;padding:5px 6px;border-radius:2px;font-weight:850}
  .tool-image{height:116px;position:relative;margin:8px -2px 0;border-radius:5px;overflow:hidden;background:linear-gradient(150deg,#f7f8f9,#e6eaec);border:1px solid #e3e7ea}
  .tool-image:after{content:"";position:absolute;left:10px;right:10px;bottom:9px;height:1px;background:#d3dade}

  .art-weight{position:absolute;inset:0}
  .art-weight span{position:absolute;display:block;height:11px;border-radius:999px;background:linear-gradient(180deg,#f6f8f8,#8b969d 44%,#46525b 70%,#b9c2c7);box-shadow:0 6px 7px #25333c24;transform:rotate(-10deg)}
  .art-weight span:nth-child(1){width:86%;left:8%;top:42px}.art-weight span:nth-child(2){width:79%;left:14%;top:56px}.art-weight span:nth-child(3){width:73%;left:20%;top:70px}

  .art-rebar{position:absolute;inset:0;transform:rotate(-10deg)}
  .art-rebar span{position:absolute;left:11%;right:16%;height:8px;border-radius:999px;background:linear-gradient(180deg,#f1f4f5,#727e87 58%,#414c54);box-shadow:0 4px 6px #25333c24}
  .art-rebar span:nth-child(1){top:34px}.art-rebar span:nth-child(2){top:47px}.art-rebar span:nth-child(3){top:60px}.art-rebar span:nth-child(4){top:73px}
  .art-rebar:after{content:"";position:absolute;right:17px;bottom:20px;width:28px;height:28px;border-radius:50%;border:6px solid #64717a;background:#28343d;box-shadow:0 0 0 2px #c5cdd2}

  .art-plate span{position:absolute;display:block;width:72%;height:21px;left:14%;border-radius:3px;border:1px solid #acb7bf;background:linear-gradient(145deg,#fff,#c7cfd4 45%,#9eaab2 65%,#f1f3f4);box-shadow:0 6px 8px #25333c1f;transform:skewY(-7deg)}
  .art-plate span:nth-child(1){top:60px}.art-plate span:nth-child(2){top:46px;left:18%}.art-plate span:nth-child(3){top:32px;left:22%}

  .art-pipe{position:absolute;inset:0}
  .art-pipe span{position:absolute;width:82px;height:40px;left:30px;top:38px;border-radius:50%;background:linear-gradient(145deg,#f8fafb,#8a979f 45%,#53606a 68%,#d7dde1);box-shadow:0 7px 9px #25333c24;transform:rotate(-15deg)}
  .art-pipe span:after{content:"";position:absolute;inset:9px 11px;border-radius:50%;background:#26333c}
  .art-pipe i{position:absolute;width:42px;height:42px;left:83px;top:31px;border-radius:50%;border:7px solid #65727c;background:#26333c;box-shadow:0 0 0 2px #c6cfd4}

  .art-cost span{position:absolute;width:56px;height:66px;left:19px;top:23px;border:1px solid #bac3c9;border-radius:4px;background:#fff;box-shadow:0 7px 10px #25333c15;transform:rotate(-3deg)}
  .art-cost span:after{content:"";position:absolute;left:11px;right:11px;top:16px;height:1px;background:#d4a15a;box-shadow:0 9px 0 #e2e6e8,0 18px 0 #e2e6e8,0 27px 0 #e2e6e8}
  .art-cost b{position:absolute;right:19px;top:29px;width:43px;height:43px;border-radius:50%;display:grid;place-items:center;background:#dd9634;color:#fff;font:700 20px Georgia,serif;box-shadow:0 7px 12px #cd8b322f}
  .art-cost i{position:absolute;right:20px;bottom:20px;width:31px;height:3px;background:#d49a45;box-shadow:0 -8px 0 #e2e5e7}

  .tool-card h2{font-size:11px;line-height:1.25;letter-spacing:-.1px;margin:10px 0 5px;color:#1f2b35}
  .tool-card>p{font-size:7.8px;line-height:1.6;color:#7c878f;margin:0;min-height:38px}
  .tool-card-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #edf0f2;margin-top:auto;padding-top:10px}
  .tool-card-bottom span{font-size:6.5px;text-transform:uppercase;letter-spacing:1px;font-weight:850;color:#a1a9af}.tool-card-bottom b{font-size:13px;color:#d18f2d}

  .no-results{margin:15px 0 0;border:1px dashed #d9dfe3;border-radius:6px;padding:13px;color:#8d969e;font-size:9px;background:#fafbfb}

  .guide{display:grid;grid-template-columns:.85fr 1.15fr;gap:8%;padding:47px 0 54px;border-top:1px solid #e0e5e8;margin-top:52px}
  .guide h2{font-size:30px;line-height:1.1;letter-spacing:-1.3px;margin:12px 0 0;color:#17212b}
  .guide-intro p{max-width:410px;font-size:9px;line-height:1.75;color:#7a858e;margin:13px 0 0}
  .steps>div{display:flex;gap:18px;padding:0 0 15px;margin-bottom:15px;border-bottom:1px solid #e5e8ea}
  .steps>div:last-child{margin-bottom:0;border-bottom:0;padding-bottom:0}
  .steps>div>span{font-size:7px;font-weight:850;color:#d18f2d;padding-top:2px}
  .steps h3{font-size:10px;margin:0 0 5px;color:#29353e}.steps p{font-size:8px;line-height:1.65;color:#7d8790;margin:0}

  .estimate-note{display:flex;justify-content:space-between;align-items:center;gap:26px;border-top:1px solid #dfe4e7;padding:19px 0}
  .estimate-note strong{font-size:8px;color:#4b5962}.estimate-note p{max-width:760px;font-size:8px;line-height:1.7;color:#8d969e;margin:5px 0 0}.estimate-note a{font-size:8px;font-weight:800;color:#69757d;text-decoration:none;white-space:nowrap}.estimate-note a span{color:#c4862c;margin-left:5px}

  footer{border-top:1px solid #dfe4e7;padding:22px 0 25px;display:grid;grid-template-columns:1.15fr .7fr .7fr;gap:30px}
  .footer-brand-wrap>p{font-size:8px;line-height:1.7;color:#89949c;max-width:275px;margin:8px 0 0}
  .footer-brand{font-size:15px}.footer-brand .brand-mark{width:26px;height:26px}.footer-brand small{font-size:6.5px}
  .footer-col strong{font-size:7px;letter-spacing:1.2px;color:#66727c;text-transform:uppercase}.footer-col a{display:block;margin-top:8px;color:#7f8991;text-decoration:none;font-size:8px}.footer-col a:hover{color:#17212b}
  .footer-bottom{grid-column:1/-1;border-top:1px solid #e7eaec;padding-top:13px;display:flex;justify-content:space-between;gap:20px}.footer-bottom span{font-size:7px;color:#9aa2a8}

  @media(max-width:1120px){
    .site-shell{padding:0 4.5%}.topbar{gap:17px}.topbar nav{gap:19px}.header-search{width:160px}
    .directory-hero{grid-template-columns:1fr 220px}.tool-grid{grid-template-columns:repeat(3,1fr)}
  }

  @media(max-width:820px){
    .site-shell{padding:0 4%}.topbar{height:74px}.topbar nav,.header-tools{display:none}.header-search{display:none}
    .directory-hero{display:block;padding:42px 0 28px}.hero-panel{margin-top:20px;max-width:260px}
    .directory-bar{display:block}.search-box{width:100%}.directory-stats{margin-top:12px;flex-wrap:wrap}
    .tool-grid{grid-template-columns:1fr 1fr}
    .guide{grid-template-columns:1fr;gap:27px}
    .estimate-note{align-items:flex-start;flex-direction:column}
  }

  @media(max-width:560px){
    .site-shell{padding:0 18px}.topbar{height:70px}.brand{font-size:17px}.nav-cta{padding:9px 10px;font-size:8px}
    .crumbs{padding-top:15px}.directory-hero{padding-top:31px}.directory-hero h1{font-size:42px;letter-spacing:-2.7px}
    .tool-grid{grid-template-columns:1fr;gap:10px}.tool-card{min-height:260px}
    .guide{padding:38px 0 44px}.guide h2{font-size:28px}
    footer{grid-template-columns:1fr 1fr}.footer-bottom{grid-column:1/-1;flex-direction:column;gap:5px}
  }
</style>
