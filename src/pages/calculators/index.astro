---
import Layout from '../../layouts/Layout.astro';

const calculators = [
  {
    number: '01',
    title: 'Steel Weight Calculator',
    description: 'Calculate weight of common steel sections from dimensions, length, quantity, and density.',
    href: '/calculators/steel-weight',
    tag: 'WEIGHT',
    visual: 'weight'
  },
  {
    number: '02',
    title: 'TMT Rebar Calculator',
    description: 'Find the weight of TMT bars using diameter, length per bar, and quantity.',
    href: '/calculators/tmt-rebar',
    tag: 'REBAR',
    visual: 'rebar'
  },
  {
    number: '03',
    title: 'Steel Plate Calculator',
    description: 'Calculate plate weight from thickness, width, length, and sheet quantity.',
    href: '/calculators/steel-plate',
    tag: 'PLATE',
    visual: 'plate'
  },
  {
    number: '04',
    title: 'Steel Pipe Calculator',
    description: 'Calculate steel pipe weight from diameter, wall thickness, length, and density.',
    href: '/calculators/steel-pipe',
    tag: 'PIPE',
    visual: 'pipe'
  },
  {
    number: '05',
    title: 'Steel Cost Calculator',
    description: 'Estimate material cost from weight, rate per kg, quantity, and allowance.',
    href: '/calculators/steel-cost',
    tag: 'COST',
    visual: 'cost'
  }
];

const directorySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Steel & Construction Calculators',
  url: Astro.site ? new URL('/calculators', Astro.site).toString() : undefined,
  description: 'SteelCalc calculator directory for steel, construction, structural section, earthwork, and reinforcement estimates.'
};

const constructionCalculators = [
  {
    number: 'C01',
    title: 'Concrete Calculator',
    description: 'Estimate concrete volume, cement bags, sand, and aggregate for common construction elements.',
    href: '/calculators/concrete',
    tag: 'CONCRETE',
    visual: 'concrete'
  },
  {
    number: 'C02',
    title: 'Brick & Block Calculator',
    description: 'Estimate masonry units, mortar, cement, and sand for walls using custom unit dimensions.',
    href: '/calculators/brick-block',
    tag: 'MASONRY',
    visual: 'masonry'
  },
  {
    number: 'C03',
    title: 'Plaster Calculator',
    description: 'Estimate plaster volume, cement bags, and sand from surface area and thickness.',
    href: '/calculators/plaster',
    tag: 'PLASTER',
    visual: 'plaster'
  },
  {
    number: 'C04',
    title: 'Flooring & Tile Calculator',
    description: 'Estimate tile count, floor coverage, wastage, and boxes for flooring projects.',
    href: '/calculators/flooring',
    tag: 'FLOORING',
    visual: 'flooring'
  },
  {
    number: 'C05',
    title: 'Excavation & Earthwork Calculator',
    description: 'Estimate excavation, loose haul, and planning fill volumes for site earthwork.',
    href: '/calculators/earthwork',
    tag: 'EARTHWORK',
    visual: 'earthwork'
  },
  {
    number: 'C06',
    title: 'Structural Steel Profiles',
    description: 'Estimate section area, unit mass, and weight for angles, channels, I-beams, SHS, RHS, and CHS.',
    href: '/calculators/structural-steel',
    tag: 'STRUCTURAL',
    visual: 'structural'
  },
  {
    number: 'C07',
    title: 'Rebar BBS Calculator',
    description: 'Build a basic reinforcement bar bending schedule with cutting length and steel weight.',
    href: '/calculators/bbs',
    tag: 'BBS',
    visual: 'bbs'
  }
];
---

<Layout
  title="All Steel & Construction Calculators | SteelCalc"
  description="Explore SteelCalc's free steel and construction calculators for weight, rebar, concrete, masonry, plaster, flooring, earthwork, structural sections, and BBS estimates."
>
  <div class="site-shell">
    

    <main>
      <div class="crumbs" aria-label="Breadcrumb">
        <a href="/">SteelCalc</a><span>/</span><strong>Calculators</strong>
      </div>      <script type="application/ld+json" set:html={JSON.stringify(directorySchema)}></script>

      <section class="directory-hero">
        <div>
          <div class="eyebrow">FREE ONLINE TOOLS</div>
          <h1>Steel & <em>Construction Calculators</em></h1>
          <p>Start with steel weight and cost tools, or use construction calculators for practical project quantity estimates.</p>
        </div>

        <div class="hero-panel">
          <strong>12</strong>
          <span>Calculators</span>
          <small>05 core steel tools · 07 construction & engineering tools</small>
        </div>
      </section>

      <section class="directory-bar" aria-label="Calculator search and summary">
        <label class="search-box">
          <span aria-hidden="true">⌕</span>
          <input id="calculator-search" type="search" placeholder="Search calculators..." autocomplete="off" />
        </label>

        <div class="directory-stats">
          <span><strong>12</strong> tools</span>
          <span>05 core steel · 07 construction & engineering</span>
          <span>Instant results</span>
          <span>No sign-up</span>
        </div>
      </section>

      <section class="tool-grid" id="calculator-grid" aria-label="Steel calculator directory">
        {calculators.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <div class="tool-card-top">
              <span class="tool-number">{tool.number}</span>
              <span class="tool-tag">{tool.tag}</span>
            </div>

            <div class={`tool-image ${tool.visual}`} aria-hidden="true">
              {tool.visual === 'weight' && <div class="art-weight"><span></span><span></span><span></span></div>}
              {tool.visual === 'rebar' && <div class="art-rebar"><span></span><span></span><span></span><span></span></div>}
              {tool.visual === 'plate' && <div class="art-plate"><span></span><span></span><span></span></div>}
              {tool.visual === 'pipe' && <div class="art-pipe"><span></span><i></i></div>}
              {tool.visual === 'cost' && <div class="art-cost"><span></span><b>₹</b><i></i></div>}
            </div>

            <h2>{tool.title}</h2>
            <p>{tool.description}</p>

            <div class="tool-card-bottom">
              <span>OPEN CALCULATOR</span>
              <b aria-hidden="true">→</b>
            </div>
          </a>
        ))}
      </section>

      <p class="no-results" id="no-results" hidden>No calculator matches that search. Try “concrete”, “brick”, “block”, “plaster”, “flooring”, “tile”, “earthwork”, “structural”, “angle”, “channel”, “BBS”, “stirrup”, “pipe”, “rebar”, “plate”, “cost”, or “weight”.</p>

      <section class="engineering-section" aria-labelledby="engineering-title">
        <div class="section-heading">
          <div>
            <div class="eyebrow">CONSTRUCTION & ENGINEERING</div>
            <h2 id="engineering-title">Build beyond <em>steel.</em></h2>
          </div>
          <p>Practical quantity calculators for the next parts of a construction estimate.</p>
        </div>

        <div class="tool-grid engineering-grid">
          {constructionCalculators.map((tool) => (
            <a class="tool-card" href={tool.href}>
              <div class="tool-card-top">
                <span class="tool-number">{tool.number}</span>
                <span class="tool-tag">{tool.tag}</span>
              </div>

              <div class={`tool-image ${tool.visual}`} aria-hidden="true">
                {tool.visual === 'concrete' && <div class="art-concrete"><span></span><i></i><b>m³</b></div>}
                {tool.visual === 'masonry' && <div class="art-masonry"><span></span><i></i><b>BRICK</b></div>}
                {tool.visual === 'plaster' && <div class="art-plaster"><span></span><i></i><b>m²</b></div>}
                {tool.visual === 'flooring' && <div class="art-flooring"><span></span><i></i><b>600</b></div>}
                {tool.visual === 'earthwork' && <div class="art-earthwork"><span></span><i></i><b>m³</b></div>}
                {tool.visual === 'structural' && <div class="art-structural"><span></span><i></i><b>H</b></div>}
                {tool.visual === 'bbs' && <div class="art-bbs"><span></span><i></i><b>BBS</b></div>}
              </div>

              <h2>{tool.title}</h2>
              <p>{tool.description}</p>

              <div class="tool-card-bottom">
                <span>OPEN CALCULATOR</span>
                <b aria-hidden="true">→</b>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="guide" id="guide">
        <div class="guide-intro">
          <div class="eyebrow">HOW IT WORKS</div>
          <h2>Measure. Calculate.<br /><em>Move forward.</em></h2>
          <p>Use familiar dimensions, get an instant estimate, and keep the result handy for your next step.</p>
        </div>

        <div class="steps">
          <div><span>01</span><section><h3>Choose a calculator</h3><p>Start with the steel form that matches your material.</p></section></div>
          <div><span>02</span><section><h3>Enter your measurements</h3><p>Use the units shown beside each input field.</p></section></div>
          <div><span>03</span><section><h3>Review and share</h3><p>Copy, print, or share the calculation whenever you need it.</p></section></div>
        </div>
      </section>

      <section class="estimate-note">
        <div>
          <strong>About the estimates</strong>
          <p>SteelCalc provides calculation-based estimates. Actual purchased weight or cost can vary because of grade, manufacturing tolerances, coating, supplier pricing, and project-specific specifications.</p>
        </div>
        <a href="/">Back to home <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    
  </div>
</Layout>

<script>
  const search = document.querySelector('#calculator-search');
  const headerSearch = document.querySelector('.header-search input');
  const cards = Array.from(document.querySelectorAll('.tool-card'));
  const noResults = document.querySelector('#no-results');

  const applyFilter = (value) => {
    const query = value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const text = card.textContent?.toLowerCase() || '';
      const match = !query || text.includes(query);
      card.toggleAttribute('hidden', !match);
      if (match) visible += 1;
    });

    if (noResults) noResults.hidden = visible > 0;
  };

  const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
  if (search) search.value = initialQuery;
  if (headerSearch) headerSearch.value = initialQuery;
  applyFilter(initialQuery);

  const syncSearch = (value) => {
    const query = value.trim();
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
    if (search) search.value = query;
    if (headerSearch) headerSearch.value = query;
    applyFilter(query);
  };

  search?.addEventListener('input', () => syncSearch(search.value));
  headerSearch?.addEventListener('input', () => syncSearch(headerSearch.value));
</script>

<style>
  :global(*){box-sizing:border-box}
  :global(html){scroll-behavior:smooth}
  :global(body){margin:0;background:#f7f8f9;color:#17212b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}

  .site-shell{max-width:1460px;margin:0 auto;padding:0 5.8%}
  .topbar{height:82px;display:flex;align-items:center;gap:28px;border-bottom:1px solid #e4e7e9}
  .brand{display:flex;align-items:center;gap:9px;text-decoration:none;color:#18232d;font-size:19px;font-weight:850;letter-spacing:-.8px;line-height:1;margin-right:auto}
  .brand-light{font-weight:450;color:#68747e}
  .brand small{display:block;font-size:6.5px;letter-spacing:1.8px;font-weight:800;color:#8c969f;margin-top:5px}
