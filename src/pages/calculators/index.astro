---
import Layout from '../../layouts/Layout.astro';

const calculators = [
  {
    number: '01',
    title: 'Steel Weight Calculator',
    description: 'Estimate the weight of round, square, and rectangular steel bars from dimensions, length, quantity, and density.',
    href: '/calculators/steel-weight',
    tag: 'WEIGHT'
  },
  {
    number: '02',
    title: 'TMT / Rebar Calculator',
    description: 'Calculate nominal TMT or rebar weight from diameter, length per bar, and number of bars.',
    href: '/calculators/tmt-rebar',
    tag: 'REBAR'
  },
  {
    number: '03',
    title: 'Steel Plate Calculator',
    description: 'Calculate steel plate weight from thickness, width, length, and sheet quantity.',
    href: '/calculators/steel-plate',
    tag: 'PLATE'
  },
  {
    number: '04',
    title: 'Steel Pipe Calculator',
    description: 'Estimate steel pipe weight using outside diameter, wall thickness, length, and density.',
    href: '/calculators/steel-pipe',
    tag: 'PIPE'
  },
  {
    number: '05',
    title: 'Steel Cost Calculator',
    description: 'Turn steel weight into a quick material-cost estimate using a rate per kilogram and optional allowance.',
    href: '/calculators/steel-cost',
    tag: 'COST'
  }
];
---

<Layout
  title="Steel Calculators | SteelCalc"
  description="Explore SteelCalc's free steel weight, TMT rebar, steel plate, steel pipe, and steel cost calculators."
>
  <div class="hub">
    <header class="topbar">
      <a class="brand" href="/" aria-label="SteelCalc home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a class="active" href="/calculators">Calculators</a>
      </nav>
      <a class="nav-cta" href="/#how-it-works">How it works <span aria-hidden="true">↗</span></a>
    </header>

    <main>
      <div class="crumbs" aria-label="Breadcrumb">
        <a href="/">SteelCalc</a><span>/</span><strong>Calculators</strong>
      </div>

      <section class="hero">
        <div>
          <div class="eyebrow"><span class="status-dot"></span> FREE STEEL CALCULATORS</div>
          <h1>Pick the right <em>tool.</em></h1>
          <p>Use the calculator that matches the steel shape, quantity, or cost you are working with. Enter familiar dimensions and get a practical estimate in seconds.</p>
        </div>
        <div class="hero-note">
          <span>05</span>
          <strong>Practical tools</strong>
          <small>Weight, rebar, plate, pipe, and cost in one place.</small>
        </div>
      </section>

      <section class="tool-grid" aria-label="Steel calculator directory">
        {calculators.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <div class="card-top">
              <span class="number">{tool.number}</span>
              <span class="tag">{tool.tag}</span>
            </div>
            <div class="symbol" aria-hidden="true"><span></span><i></i></div>
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <div class="card-bottom"><span>OPEN TOOL</span><b aria-hidden="true">↗</b></div>
          </a>
        ))}
      </section>

      <section class="guide">
        <div>
          <div class="eyebrow">HOW TO USE STEELCALC</div>
          <h2>Dimensions in.<br /><em>Useful estimate out.</em></h2>
        </div>
        <div class="steps">
          <div><span>01</span><section><h3>Choose a calculator</h3><p>Start with the steel form closest to your material.</p></section></div>
          <div><span>02</span><section><h3>Enter measurements</h3><p>Use the units shown beside each input so the calculation is consistent.</p></section></div>
          <div><span>03</span><section><h3>Review the result</h3><p>Check the main result and the supporting breakdown before planning your next step.</p></section></div>
        </div>
      </section>

      <section class="notes">
        <div>
          <strong>About the estimates</strong>
          <p>SteelCalc provides calculation-based estimates. Actual purchased weight or cost can vary because of grade, manufacturing tolerances, coating, supplier pricing, and project-specific specifications.</p>
        </div>
        <a href="/">Back to SteelCalc home <span>↗</span></a>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span></a>
      <p>Practical steel estimates, without the extra steps.</p>
      <span>© {new Date().getFullYear()} SteelCalc</span>
    </footer>
  </div>
</Layout>

<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;background:#f6f7f8;color:#17212b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
  .hub{max-width:1180px;margin:0 auto;padding:0 28px 65px}
  .topbar{height:94px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e3e7e9}
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:#18232d;font-size:20px;font-weight:850;letter-spacing:-.8px;line-height:1}
  .brand-light{font-weight:450;color:#67727d}.brand small{display:block;font-size:8px;letter-spacing:2px;font-weight:750;color:#8b969f;margin-top:6px}
  .brand-mark{width:31px;height:31px;background:#e9a23b;border-radius:8px;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:7px}.brand-mark span{display:block;width:4px;background:#17212b;border-radius:1px}.brand-mark span:nth-child(1){height:8px}.brand-mark span:nth-child(2){height:14px}.brand-mark span:nth-child(3){height:11px}
  .topbar nav{display:flex;gap:30px}.topbar nav a{font-size:12px;font-weight:650;color:#65717c;text-decoration:none}.topbar nav a:hover,.topbar nav a.active{color:#17212b}
  .nav-cta{font-size:12px;font-weight:750;color:#17212b;text-decoration:none;border:1px solid #d7dde1;padding:12px 16px;border-radius:7px}.nav-cta span{color:#d68c23;margin-left:9px}
  .crumbs{display:flex;gap:9px;align-items:center;padding:22px 0;font-size:10px;color:#9aa3aa}.crumbs a{color:#68737c;text-decoration:none;font-weight:700}.crumbs span{color:#d0d5d9}.crumbs strong{font-weight:700;color:#808a92}
  .hero{display:flex;align-items:flex-end;justify-content:space-between;gap:35px;padding:56px 0 45px}.eyebrow{font-size:9px;font-weight:800;letter-spacing:2px;color:#8a949d;display:flex;align-items:center;gap:9px}.status-dot{width:6px;height:6px;background:#e6a13a;border-radius:50%;box-shadow:0 0 0 4px #f7ead7}
  h1{font-size:clamp(42px,5vw,62px);line-height:1.04;letter-spacing:-3.4px;margin:20px 0 15px;font-weight:780;color:#17212b}h1 em,h2 em{font-family:Georgia,serif;font-weight:500;color:#c88427}
  .hero p{max-width:650px;margin:0;color:#6c7780;font-size:13px;line-height:1.85}.hero-note{min-width:235px;border:1px solid #dde2e6;border-radius:9px;background:#fff;padding:18px}.hero-note span{font-family:Georgia,serif;color:#c4862c;font-size:26px}.hero-note strong{display:block;font-size:12px;color:#26333d;margin-top:5px}.hero-note small{display:block;color:#949da5;font-size:9px;line-height:1.6;margin-top:4px}
  .tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tool-card{display:block;text-decoration:none;color:inherit;background:#fff;border:1px solid #e1e6e9;border-radius:9px;padding:22px 21px 18px;min-height:245px;transition:transform .2s,border-color .2s,box-shadow .2s}.tool-card:hover{transform:translateY(-3px);border-color:#d5b172;box-shadow:0 13px 30px #17232d0a}
  .card-top,.card-bottom{display:flex;justify-content:space-between;align-items:center}.number{font-size:10px;font-weight:850;color:#c4862c}.tag{font-size:7px;letter-spacing:1.2px;color:#89949d;background:#f4f6f7;border-radius:3px;padding:6px 8px;font-weight:800}
  .symbol{position:relative;height:46px;width:52px;margin:19px 0 12px}.symbol span,.symbol i{position:absolute;display:block;transform:skewY(-22deg)}.symbol span{left:3px;top:8px;width:37px;height:28px;border:1px solid #b8c2ca;background:linear-gradient(130deg,#f9fafb,#d9dfe3)}.symbol i{left:12px;top:15px;width:31px;height:23px;border:1px solid #d2a15c;background:linear-gradient(135deg,#f2c77f,#d99a3c);box-shadow:3px 4px 0 #bd8536}
  .tool-card h2{font-size:15px;letter-spacing:-.25px;margin:0 0 8px;color:#202c36}.tool-card p{font-size:10px;line-height:1.7;color:#7d8790;margin:0;min-height:51px}.card-bottom{border-top:1px solid #edf0f2;margin-top:18px;padding-top:13px}.card-bottom span{font-size:7px;letter-spacing:1.2px;font-weight:850;color:#9ca5ac}.card-bottom b{font-size:15px;color:#c4862c}
  .guide{display:grid;grid-template-columns:.85fr 1.15fr;gap:9%;border-top:1px solid #dfe4e7;margin-top:60px;padding:48px 0 44px}.guide h2{font-size:33px;line-height:1.15;letter-spacing:-1.4px;margin:13px 0 0;color:#17212b}.steps>div{display:flex;gap:18px;padding:0 0 17px;margin-bottom:17px;border-bottom:1px solid #e5e8eb}.steps>div:last-child{border:0;margin-bottom:0;padding-bottom:0}.steps>div>span{font-size:10px;font-weight:850;color:#c4862c}.steps h3{font-size:12px;color:#2c3841;margin:0 0 5px}.steps p{font-size:10px;line-height:1.65;color:#7e8890;margin:0}
  .notes{display:flex;justify-content:space-between;align-items:center;gap:28px;border-top:1px solid #dfe4e7;padding-top:21px}.notes strong{font-size:10px;color:#4b5962}.notes p{max-width:720px;font-size:9px;line-height:1.65;color:#8d969e;margin:5px 0 0}.notes a{font-size:10px;font-weight:750;color:#68747d;text-decoration:none;white-space:nowrap}.notes a span{color:#c4862c;margin-left:6px}
  footer{border-top:1px solid #dfe4e7;margin-top:40px;padding:24px 0 8px;display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-brand{font-size:16px}.footer-brand .brand-mark{width:27px;height:27px}.footer-brand small{font-size:7px}footer p,footer>span{font-size:9px;color:#8a949d;margin:0}
  @media(max-width:850px){.hero{display:block}.hero-note{margin-top:23px;max-width:260px}.tool-grid{grid-template-columns:1fr 1fr}.guide{grid-template-columns:1fr;gap:30px}.notes{align-items:flex-start;flex-direction:column}.notes a{white-space:normal}}
  @media(max-width:600px){.hub{padding:0 18px 50px}.topbar{height:75px}.topbar nav{display:none}.nav-cta{padding:10px 12px;font-size:10px}.hero{padding:36px 0 32px}h1{font-size:44px;letter-spacing:-2.7px}.tool-grid{grid-template-columns:1fr}.tool-card{min-height:220px}footer{flex-wrap:wrap;align-items:flex-start}footer p{order:3;flex-basis:100%}}
</style>
