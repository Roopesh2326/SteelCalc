---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Steel Project Workbench | SteelCalc"
  description="Combine multiple steel items into one project estimate with total weight, tonnes, cost, wastage, GST, and CSV export."
>
  <div class="workbench-shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="SteelCalc home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Steel<span class="brand-light">Calc</span><small>PRECISION TOOLS</small></span>
      </a>
      <nav aria-label="Workbench navigation">
        <a href="/calculators">Calculators</a>
        <a href="/guides">Guides</a>
        <a class="active" href="/workbench">Workbench</a>
      </nav>
      <a class="nav-cta" href="/calculators">All calculators <span>→</span></a>
    </header>

    <main>
      <div class="crumbs"><a href="/">SteelCalc</a><span>/</span><strong>Project Workbench</strong></div>

      <section class="hero">
        <div>
          <div class="eyebrow">PROJECT MODE</div>
          <h1>Build one steel estimate.<br /><em>Not five separate tabs.</em></h1>
          <p>Add multiple TMT, round bar, plate, and pipe items. SteelCalc combines the weight, tonnes, material cost, transport, and GST into one project view.</p>
        </div>
        <div class="hero-chip"><strong>LOCAL ONLY</strong><span>Saved in this browser</span><small>Your project stays on the device unless you export it.</small></div>
      </section>

      <section class="project-head">
        <div class="field"><label for="project-name">Project name</label><input id="project-name" value="Steel Estimate" /></div>
        <div class="field"><label for="transport">Transport <span>₹</span></label><input id="transport" type="number" min="0" step="0.01" placeholder="0" /></div>
        <div class="field"><label for="gst">GST <span>%</span></label><input id="gst" type="number" min="0" step="0.1" placeholder="0" /></div>
      </section>

      <section class="workbench-card">
        <div class="table-head">
          <div><span class="form-kicker">MATERIAL LIST</span><h2>Add project items</h2></div>
          <div class="toolbar"><button id="save-btn" class="ghost">Save</button><button id="load-btn" class="ghost">Load</button><button id="clear-btn" class="ghost">Clear</button><button id="csv-btn" class="primary">CSV ↓</button></div>
        </div>

        <div class="item-table-wrap">
          <table>
            <thead>
              <tr><th>Material</th><th>Diameter / Size</th><th>Dimensions</th><th>Length</th><th>Qty</th><th>Rate / kg</th><th>Weight</th><th>Amount</th><th></th></tr>
            </thead>
            <tbody id="items-body"></tbody>
          </table>
        </div>

        <div class="empty" id="empty-state">
          <strong>Your project is empty.</strong>
          <p>Add your first steel item to start building the estimate.</p>
        </div>

        <div class="add-row">
          <button id="add-item" class="add-btn">+ Add steel item</button>
          <span>Supports TMT/rebar, round bar, plate, and round pipe.</span>
        </div>
      </section>

      <section class="summary-grid">
        <div class="summary-card"><span>Total weight</span><strong id="total-weight">0.00 kg</strong><small id="total-tonnes">0.000 t</small></div>
        <div class="summary-card"><span>Material cost</span><strong id="material-cost">₹0.00</strong><small>Before transport & GST</small></div>
        <div class="summary-card"><span>Transport</span><strong id="transport-cost">₹0.00</strong><small>Project allowance</small></div>
        <div class="summary-card dark"><span>Estimated total</span><strong id="grand-total">₹0.00</strong><small id="tax-note">GST not added</small></div>
      </section>

      <section class="notes">
        <div><strong>Why use Workbench?</strong><p>Keep several material lines in one estimate so a mixed order can be checked as a single project instead of being calculated one item at a time.</p></div>
        <a href="/guides">Open calculation guides <span>↗</span></a>
      </section>
    </main>
  </div>
</Layout>

<script>
  const body = document.querySelector('#items-body');
  const empty = document.querySelector('#empty-state');
  const nameInput = document.querySelector('#project-name');
  const transportInput = document.querySelector('#transport');
  const gstInput = document.querySelector('#gst');
  const totalWeight = document.querySelector('#total-weight');
  const totalTonnes = document.querySelector('#total-tonnes');
  const materialCost = document.querySelector('#material-cost');
  const transportCost = document.querySelector('#transport-cost');
  const grandTotal = document.querySelector('#grand-total');
  const taxNote = document.querySelector('#tax-note');

  const format = (n, digits = 2) => Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: digits });
  const money = (n) => '₹' + format(n, 2);

  const newItem = (type = 'tmt') => ({
    id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now() + Math.random()),
    type,
    diameter: '',
    width: '',
    thickness: '',
    plateLength: '',
    length: '',
    qty: '',
    rate: ''
  });

  let items = [newItem('tmt')];

  const calc = (item) => {
    const qty = Math.max(0, Number(item.qty) || 0);
    const rate = Math.max(0, Number(item.rate) || 0);
    let kgPerUnit = 0;

    if (item.type === 'tmt' || item.type === 'round') {
      const d = Math.max(0, Number(item.diameter) || 0);
      const len = Math.max(0, Number(item.length) || 0);
      kgPerUnit = d * d / 162.2 * len;
    }

    if (item.type === 'plate') {
      const t = Math.max(0, Number(item.thickness) || 0);
      const w = Math.max(0, Number(item.width) || 0);
      const l = Math.max(0, Number(item.plateLength) || 0);
      kgPerUnit = t * w * l * 0.00000785;
    }

    if (item.type === 'pipe') {
      const od = Math.max(0, Number(item.diameter) || 0);
      const wt = Math.max(0, Number(item.thickness) || 0);
      const len = Math.max(0, Number(item.length) || 0);
      const id = od - 2 * wt;
      if (id <= 0) return { kg: 0, amount: 0, unit: 0, invalid: true };
      const area = Math.PI / 4 * (od * od - id * id);
      const kgPerM = area / 1_000_000 * 7850;
      kgPerUnit = kgPerM * len;
    }

    return { kg: kgPerUnit * qty, amount: kgPerUnit * qty * rate, unit: kgPerUnit, invalid: false };
  };

  const render = () => {
    if (!body) return;
    empty?.toggleAttribute('hidden', items.length > 0);
    body.innerHTML = items.map((item) => {
      const result = calc(item);
      const commonSize = `<input class="mini diameter" type="number" min="0" step="0.01" value="${item.diameter}" aria-label="Diameter or size" />`;

      let cells = '';
      if (item.type === 'plate') {
        cells = `
          <td><select class="mini type"><option value="tmt">TMT</option><option value="round">Round</option><option value="plate" selected>Plate</option><option value="pipe">Pipe</option></select></td>
          <td><div class="stack"><input class="mini width" type="number" min="0" step="0.01" value="${item.width}" aria-label="Width" /><input class="mini thickness" type="number" min="0" step="0.01" value="${item.thickness}" aria-label="Thickness" /></div></td>
          <td><input class="mini plateLength" type="number" min="0" step="0.01" value="${item.plateLength}" aria-label="Length" /></td>
          <td><span class="muted">—</span></td>
          <td><input class="mini qty" type="number" min="0" step="1" value="${item.qty}" aria-label="Quantity" /></td>
          <td><input class="mini rate" type="number" min="0" step="0.01" value="${item.rate}" aria-label="Rate per kg" /></td>`;
      } else if (item.type === 'pipe') {
        cells = `
          <td><select class="mini type"><option value="tmt">TMT</option><option value="round">Round</option><option value="plate">Plate</option><option value="pipe" selected>Pipe</option></select></td>
          <td><div class="stack"><input class="mini diameter" type="number" min="0" step="0.01" value="${item.diameter}" aria-label="Outside diameter" /><input class="mini thickness" type="number" min="0" step="0.01" value="${item.thickness}" aria-label="Wall thickness" /></div></td>
          <td><span class="muted">OD × WT</span></td>
          <td><input class="mini length" type="number" min="0" step="0.01" value="${item.length}" aria-label="Length" /></td>
          <td><input class="mini qty" type="number" min="0" step="1" value="${item.qty}" aria-label="Quantity" /></td>
          <td><input class="mini rate" type="number" min="0" step="0.01" value="${item.rate}" aria-label="Rate per kg" /></td>`;
      } else {
        cells = `
          <td><select class="mini type"><option value="tmt" ${item.type === 'tmt' ? 'selected' : ''}>TMT</option><option value="round" ${item.type === 'round' ? 'selected' : ''}>Round</option><option value="plate">Plate</option><option value="pipe">Pipe</option></select></td>
          <td>${commonSize}</td>
          <td><span class="muted">—</span></td>
          <td><input class="mini length" type="number" min="0" step="0.01" value="${item.length}" aria-label="Length" /></td>
          <td><input class="mini qty" type="number" min="0" step="1" value="${item.qty}" aria-label="Quantity" /></td>
          <td><input class="mini rate" type="number" min="0" step="0.01" value="${item.rate}" aria-label="Rate per kg" /></td>`;
      }

      return `
        <tr data-id="${item.id}">
          ${cells}
          <td class="weight-cell">${result.invalid ? 'Invalid OD/WT' : `${format(result.kg)} kg`}</td>
          <td class="amount-cell">${money(result.amount)}</td>
          <td><button class="remove" type="button" title="Remove item" aria-label="Remove item">×</button></td>
        </tr>`;
    }).join('');

    body.querySelectorAll('tr').forEach((tr) => {
      const item = items.find((entry) => entry.id === tr.dataset.id);
      if (!item) return;

      tr.querySelectorAll('input, select').forEach((field) => {
        field.addEventListener('input', () => {
          if (field.classList.contains('type')) item.type = field.value;
          else if (field.classList.contains('diameter')) item.diameter = field.value;
          else if (field.classList.contains('width')) item.width = field.value;
          else if (field.classList.contains('thickness')) item.thickness = field.value;
          else if (field.classList.contains('plateLength')) item.plateLength = field.value;
          else if (field.classList.contains('length')) item.length = field.value;
          else if (field.classList.contains('qty')) item.qty = field.value;
          else if (field.classList.contains('rate')) item.rate = field.value;

          const result = calc(item);
          const weightCell = tr.querySelector('.weight-cell');
          const amountCell = tr.querySelector('.amount-cell');
          if (weightCell) weightCell.textContent = result.invalid ? 'Invalid OD/WT' : `${format(result.kg)} kg`;
          if (amountCell) amountCell.textContent = money(result.amount);
          refreshSummary();
        });

        field.addEventListener('change', () => {
          if (field.classList.contains('type')) {
            item.type = field.value;
            render();
          }
        });
      });

      tr.querySelector('.remove')?.addEventListener('click', () => {
        items = items.filter((entry) => entry.id !== item.id);
        render();
      });
    });

    refreshSummary();
  };

  const refreshSummary = () => {
    let weight = 0;
    let cost = 0;
    items.forEach((item) => {
      const result = calc(item);
      weight += result.kg;
      cost += result.amount;
    });

    const transport = Math.max(0, Number(transportInput?.value) || 0);
    const gst = Math.max(0, Number(gstInput?.value) || 0);
    const tax = (cost + transport) * gst / 100;
    const total = cost + transport + tax;

    if (totalWeight) totalWeight.textContent = `${format(weight)} kg`;
    if (totalTonnes) totalTonnes.textContent = `${format(weight / 1000, 3)} t`;
    if (materialCost) materialCost.textContent = money(cost);
    if (transportCost) transportCost.textContent = money(transport);
    if (grandTotal) grandTotal.textContent = money(total);
    if (taxNote) taxNote.textContent = gst ? `Includes ${format(gst, 1)}% GST` : 'GST not added';
  };

  const serialize = () => JSON.stringify({
    name: nameInput?.value || 'Steel Estimate',
    transport: transportInput?.value || '0',
    gst: gstInput?.value || '0',
    items
  });

  document.querySelector('#add-item')?.addEventListener('click', () => { items.push(newItem('tmt')); render(); });
  document.querySelector('#clear-btn')?.addEventListener('click', () => { items = []; render(); });
  transportInput?.addEventListener('input', refreshSummary);
  gstInput?.addEventListener('input', refreshSummary);
  nameInput?.addEventListener('input', () => localStorage.setItem('steelcalc-workbench', serialize()));

  document.querySelector('#save-btn')?.addEventListener('click', () => localStorage.setItem('steelcalc-workbench', serialize()));

  document.querySelector('#load-btn')?.addEventListener('click', () => {
    try {
      const saved = JSON.parse(localStorage.getItem('steelcalc-workbench') || 'null');
      if (!saved) return;
      if (nameInput) nameInput.value = saved.name || 'Steel Estimate';
      if (transportInput) transportInput.value = saved.transport ?? '';
      if (gstInput) gstInput.value = saved.gst ?? '';
      items = Array.isArray(saved.items) ? saved.items : [];
      render();
    } catch {}
  });

  document.querySelector('#csv-btn')?.addEventListener('click', () => {
    const headers = ['Material','Diameter/Size','Width','Thickness','Length','Quantity','Rate/kg','Weight/kg','Amount'];
    const lines = [headers.join(',')];

    items.forEach((item) => {
      const result = calc(item);
      const values = [
        item.type,
        item.diameter,
        item.width || '',
        item.thickness || '',
        item.type === 'plate' ? item.plateLength : item.length,
        item.qty,
        item.rate,
        Number(result.kg.toFixed(3)),
        Number(result.amount.toFixed(2))
      ];
      lines.push(values.map((value) => `"${String(value).replaceAll('"','""')}"`).join(','));
    });

    const blob = new Blob([lines.join('\\n')], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${(nameInput?.value || 'steel-estimate').replace(/[^a-z0-9-_]+/gi,'-').toLowerCase()}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  render();
</script>

<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;background:#f7f8f9;color:#17212b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  .workbench-shell{max-width:1280px;margin:0 auto;padding:0 28px 70px}.topbar{height:82px;display:flex;align-items:center;gap:25px;border-bottom:1px solid #e4e7e9}.brand{display:flex;align-items:center;gap:9px;margin-right:auto;text-decoration:none;color:#18232d;font-size:18px;font-weight:850}.brand-light{font-weight:450;color:#68747e}.brand small{display:block;font-size:6px;letter-spacing:1.7px;color:#8b969e;margin-top:5px}.brand-mark{width:28px;height:28px;background:#eca43c;border-radius:7px;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:6px}.brand-mark span{display:block;width:4px;background:#17212b}.brand-mark span:nth-child(1){height:7px}.brand-mark span:nth-child(2){height:12px}.brand-mark span:nth-child(3){height:9px}nav{display:flex;gap:24px}nav a{font-size:10px;font-weight:700;color:#68747d;text-decoration:none}nav a:hover,nav a.active{color:#17212b}.nav-cta{font-size:9px;font-weight:800;color:#fff;text-decoration:none;background:#d9932f;border-radius:6px;padding:10px 12px}
  .crumbs{display:flex;gap:8px;font-size:8px;color:#9ca5ab;padding:18px 0 9px}.crumbs a{color:#69757d;text-decoration:none}.crumbs span{color:#d0d5d9}
  .hero{display:grid;grid-template-columns:1fr 250px;gap:35px;align-items:end;padding:42px 0 28px}.eyebrow{font-size:7px;font-weight:850;letter-spacing:1.8px;color:#8b959d}.hero h1{font-size:clamp(40px,5vw,62px);letter-spacing:-3.4px;line-height:1.02;margin:15px 0}.hero h1 em{font-family:Georgia,serif;font-weight:500;color:#d9932f}.hero p{max-width:680px;font-size:11px;line-height:1.8;color:#65727b;margin:0}.hero-chip{border:1px solid #dfe4e7;background:#fff;border-radius:7px;padding:17px;box-shadow:0 8px 20px #1f2d3708}.hero-chip strong{font-size:7px;letter-spacing:1.5px;color:#c4862c}.hero-chip span{display:block;font-size:10px;font-weight:800;margin-top:7px}.hero-chip small{display:block;color:#89949c;font-size:8px;line-height:1.7;margin-top:4px}
  .project-head{display:grid;grid-template-columns:1fr 180px 150px;gap:12px;margin-bottom:15px}.field{display:flex;flex-direction:column;gap:6px}.field label{font-size:8px;font-weight:800;color:#66737c}.field label span{float:right;color:#9aa3aa}.field input,.mini{height:36px;border:1px solid #dce2e6;background:#fff;border-radius:5px;padding:0 9px;font:inherit;font-size:9px;color:#29353d;outline:none}.field input:focus,.mini:focus{border-color:#d4a360;box-shadow:0 0 0 3px #f6ead7}
  .workbench-card{background:#fff;border:1px solid #e0e5e8;border-radius:8px;box-shadow:0 10px 28px #17232d08;overflow:hidden}.table-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;padding:19px 20px;border-bottom:1px solid #e8ebed}.form-kicker{font-size:7px;letter-spacing:1.5px;font-weight:850;color:#c4862c}.table-head h2{margin:8px 0 0;font-size:19px;letter-spacing:-.7px}.toolbar{display:flex;gap:7px}.toolbar button{border-radius:5px;border:1px solid #d9dfe3;background:#fff;padding:8px 10px;font-size:8px;font-weight:800;color:#68747d;cursor:pointer}.toolbar .primary{background:#17232e;color:#fff;border-color:#17232e}.item-table-wrap{overflow:auto}.item-table-wrap table{width:100%;border-collapse:collapse;min-width:980px}.item-table-wrap th,.item-table-wrap td{padding:9px 8px;border-bottom:1px solid #eef0f2;text-align:left;font-size:8px;white-space:nowrap}.item-table-wrap th{font-size:7px;text-transform:uppercase;letter-spacing:.9px;color:#8a949c;background:#fafbfb}.item-table-wrap td{color:#58656e}.mini{height:31px;width:86px}.stack{display:flex;gap:4px}.stack .mini{width:66px}.muted{color:#a0a8ae}.weight-cell{font-weight:800;color:#2e3b44!important}.amount-cell{font-weight:800;color:#c4862c!important}.remove{width:26px;height:26px;border:0;background:#f3f5f6;color:#8b969e;border-radius:5px;cursor:pointer;font-size:16px}.empty{padding:35px;text-align:center;color:#89949c}.empty strong{font-size:11px;color:#4b5962}.empty p{font-size:9px;margin:7px 0 0}.add-row{display:flex;align-items:center;gap:12px;padding:13px 20px;border-top:1px solid #edf0f2}.add-btn{border:1px solid #d6dde1;background:#f8fafb;color:#4f5d66;border-radius:5px;padding:9px 11px;font-size:8px;font-weight:850;cursor:pointer}.add-row>span{font-size:8px;color:#98a1a8}
  .summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-top:14px}.summary-card{background:#fff;border:1px solid #e0e5e8;border-radius:7px;padding:15px}.summary-card span,.summary-card small{display:block}.summary-card span{font-size:8px;color:#7d8991}.summary-card strong{display:block;font-size:20px;letter-spacing:-.7px;color:#202d36;margin-top:8px}.summary-card small{font-size:7px;color:#9aa3aa;margin-top:6px}.summary-card.dark{background:#18252f;border-color:#18252f}.summary-card.dark span,.summary-card.dark small{color:#96a4ac}.summary-card.dark strong{color:#fff}
  .notes{display:flex;justify-content:space-between;gap:25px;align-items:center;border-top:1px solid #dfe4e7;margin-top:35px;padding-top:20px}.notes strong{font-size:9px;color:#4a5861}.notes p{max-width:760px;font-size:8px;line-height:1.7;color:#89949c;margin:6px 0 0}.notes a{font-size:8px;font-weight:800;color:#69757d;text-decoration:none;white-space:nowrap}.notes a span{color:#c4862c;margin-left:5px}
  @media(max-width:900px){.workbench-shell{padding:0 18px 50px}.topbar{height:70px}.topbar nav{display:none}.hero{grid-template-columns:1fr}.hero-chip{max-width:260px}.project-head{grid-template-columns:1fr 1fr}.project-head .field:first-child{grid-column:1/-1}.summary-grid{grid-template-columns:1fr 1fr}.notes{align-items:flex-start;flex-direction:column}}
  @media(max-width:620px){.project-head{grid-template-columns:1fr}.project-head .field:first-child{grid-column:auto}.summary-grid{grid-template-columns:1fr}.table-head{align-items:flex-start;flex-direction:column}.toolbar{flex-wrap:wrap}.add-row{align-items:flex-start;flex-direction:column}}
</style>