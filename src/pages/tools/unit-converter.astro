---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Engineering Unit Converter | SteelCalc"
  description="Convert common engineering length, area, volume, mass, and force units instantly with SteelCalc."
>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="SteelCalc home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Steel<span class="light">Calc</span><small>PRECISION TOOLS</small></span>
      </a>
      <nav aria-label="Reference navigation">
        <a href="/calculators">Calculators</a>
        <a href="/guides">Guides</a>
        <a class="active" href="/tools/unit-converter">Converter</a>
      </nav>
      <a class="cta" href="/calculators">All calculators →</a>
    </header>

    <main>
      <div class="crumb"><a href="/">SteelCalc</a><span>/</span><a href="/tools">Tools</a><span>/</span><strong>Unit Converter</strong></div>
      <section class="hero">
        <div>
          <div class="eyebrow">ENGINEERING / REFERENCE</div>
          <h1>Unit converter.<br /><em>Keep the dimensions consistent.</em></h1>
          <p>Convert common construction and engineering units before you enter dimensions into a calculator. Results update instantly in your browser.</p>
        </div>
        <div class="hero-chip"><strong>LIVE</strong><span>Length · area · volume · mass · force</span><small>No sign-up and no data leaves the browser.</small></div>
      </section>

      <section class="converter-card">
        <div class="field">
          <label for="category">Category</label>
          <select id="category">
            <option value="length">Length</option>
            <option value="area">Area</option>
            <option value="volume">Volume</option>
            <option value="mass">Mass</option>
            <option value="force">Force</option>
          </select>
        </div>
        <div class="conversion-grid">
          <div class="field">
            <label for="from">From</label>
            <select id="from"></select>
          </div>
          <div class="field value-field">
            <label for="amount">Value</label>
            <input id="amount" type="number" step="any" placeholder="1000" />
          </div>
          <div class="equals" aria-hidden="true">=</div>
          <div class="field">
            <label for="to">To</label>
            <select id="to"></select>
          </div>
        </div>
        <div class="result">
          <span>RESULT</span>
          <strong id="result">—</strong>
          <small id="result-note">Enter a value to convert.</small>
        </div>
      </section>

      <section class="reference-note">
        <div><span class="kicker">QUICK PRACTICE</span><h2>Convert first. Calculate second.</h2></div>
        <p>Keep length units consistent inside a formula. For area and volume, convert the full unit—not just the displayed number. The converter uses exact arithmetic conversion factors for the listed units.</p>
      </section>
    </main>
  </div>
</Layout>

<script>
  const definitions = {
    length: {
      mm: ['mm', 0.001], cm: ['cm', 0.01], m: ['m', 1], km: ['km', 1000],
      in: ['in', 0.0254], ft: ['ft', 0.3048], yd: ['yd', 0.9144]
    },
    area: {
      mm2: ['mm²', 0.000001], cm2: ['cm²', 0.0001], m2: ['m²', 1],
      ft2: ['ft²', 0.09290304], yd2: ['yd²', 0.83612736]
    },
    volume: {
      ml: ['mL', 0.000001], l: ['L', 0.001], m3: ['m³', 1],
      ft3: ['ft³', 0.028316846592], yd3: ['yd³', 0.764554857984]
    },
    mass: {
      g: ['g', 0.001], kg: ['kg', 1], t: ['t', 1000], lb: ['lb', 0.45359237]
    },
    force: {
      n: ['N', 1], kn: ['kN', 1000], lbf: ['lbf', 4.4482216152605]
    }
  };

  const category = document.querySelector('#category');
  const from = document.querySelector('#from');
  const to = document.querySelector('#to');
  const amount = document.querySelector('#amount');
  const result = document.querySelector('#result');
  const note = document.querySelector('#result-note');

  const format = (n) => Number(n).toLocaleString('en-IN', { maximumFractionDigits: 8 });

  const populate = () => {
    const units = definitions[category.value];
    const options = Object.entries(units).map(([key, [label]]) => `<option value="${key}">${label}</option>`).join('');
    from.innerHTML = options;
    to.innerHTML = options;
    if (from.options.length > 1) to.selectedIndex = 1;
    convert();
  };

  const convert = () => {
    const units = definitions[category.value];
    const numeric = Number(amount.value);
    if (!Number.isFinite(numeric)) {
      result.textContent = '—';
      note.textContent = 'Enter a value to convert.';
      return;
    }
    const base = numeric * units[from.value][1];
    const converted = base / units[to.value][1];
    result.textContent = `${format(converted)} ${units[to.value][0]}`;
    note.textContent = `${format(numeric)} ${units[from.value][0]} = ${format(converted)} ${units[to.value][0]}`;
  };

  category.addEventListener('change', populate);
  from.addEventListener('change', convert);
  to.addEventListener('change', convert);
  amount.addEventListener('input', convert);
  populate();
</script>

<style>
:global(body){margin:0;background:#f6f7f8;color:#17212b;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.shell{max-width:1180px;margin:0 auto;padding:0 28px 72px}.topbar{height:78px;display:flex;align-items:center;gap:26px;border-bottom:1px solid #e1e6e9}.brand{display:flex;align-items:center;gap:9px;margin-right:auto;text-decoration:none;color:#18232d;font-size:18px;font-weight:850;letter-spacing:-.7px}.light{font-weight:450;color:#68727b}.brand small{display:block;font-size:6.5px;letter-spacing:1.8px;color:#8b969d;margin-top:5px}.brand-mark{width:29px;height:29px;background:#e9a23b;border-radius:8px;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:6px}.brand-mark span{display:block;width:4px;background:#17212b}.brand-mark span:nth-child(1){height:7px}.brand-mark span:nth-child(2){height:13px}.brand-mark span:nth-child(3){height:10px}.topbar nav{display:flex;gap:24px}.topbar nav a{font-size:10px;font-weight:700;color:#68747d;text-decoration:none}.topbar nav a.active,.topbar nav a:hover{color:#17212b}.cta{font-size:9px;font-weight:800;color:#fff;text-decoration:none;background:#d9932f;padding:10px 12px;border-radius:6px}
.crumb{display:flex;gap:9px;align-items:center;font-size:9px;color:#9aa3aa;padding:21px 0}.crumb a{text-decoration:none;color:#66737c;font-weight:700}.crumb strong{font-weight:750;color:#7a858e}.hero{display:grid;grid-template-columns:1fr 285px;gap:40px;align-items:end;padding:28px 0 34px}.eyebrow,.kicker{font-size:7px;font-weight:850;letter-spacing:1.8px;color:#8b959d}.hero h1{font-size:clamp(42px,5vw,66px);line-height:1.01;letter-spacing:-3.5px;margin:14px 0 15px}.hero h1 em,h2 em{font-family:Georgia,serif;font-weight:500;color:#dc942d}.hero p{max-width:720px;font-size:11px;line-height:1.8;color:#65727b;margin:0}.hero-chip{border:1px solid #dfe4e7;background:#fff;border-radius:8px;padding:17px 18px}.hero-chip strong,.hero-chip span,.hero-chip small{display:block}.hero-chip strong{font-family:Georgia,serif;color:#c4862c;font-size:15px}.hero-chip span{font-size:9px;font-weight:800;margin-top:6px}.hero-chip small{font-size:7px;color:#8a959d;margin-top:4px;line-height:1.6}
.converter-card{border:1px solid #dfe4e7;background:#fff;border-radius:8px;padding:22px;box-shadow:0 8px 24px #17232d07}.field{display:flex;flex-direction:column;gap:7px}.field label{font-size:9px;font-weight:750;color:#5f6b75}.field input,.field select{height:44px;border:1px solid #d9dfe3;background:#fbfcfc;border-radius:6px;padding:0 12px;font-size:12px;color:#20303a;outline:0}.field input:focus,.field select:focus{border-color:#d1a25f;box-shadow:0 0 0 3px #f6e9d4}.conversion-grid{display:grid;grid-template-columns:1fr 1fr auto 1fr;gap:12px;align-items:end;margin-top:14px}.equals{font-size:19px;color:#c4862c;padding-bottom:11px}.result{margin-top:18px;padding:18px 19px;border-radius:7px;background:#18252f;color:#fff}.result span{display:block;font-size:7px;letter-spacing:1.5px;color:#d4a05a;font-weight:850}.result strong{display:block;font-family:Georgia,serif;font-size:31px;font-weight:500;margin:7px 0}.result small{color:#aebac0;font-size:8px}.reference-note{display:grid;grid-template-columns:.8fr 1.2fr;gap:45px;border-top:1px solid #dfe4e7;margin-top:43px;padding-top:33px}.reference-note h2{font-size:25px;letter-spacing:-1px;margin:10px 0 0}.reference-note p{font-size:9px;line-height:1.8;color:#7b8790;margin:0}
@media(max-width:760px){.shell{padding:0 18px 55px}.topbar nav{display:none}.hero{grid-template-columns:1fr}.conversion-grid{grid-template-columns:1fr 1fr}.equals{display:none}.reference-note{grid-template-columns:1fr;gap:20px}}
@media(max-width:520px){.conversion-grid{grid-template-columns:1fr}}
</style>
