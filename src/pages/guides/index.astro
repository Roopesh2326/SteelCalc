---
import Layout from '../../layouts/Layout.astro';
const guides = [
  { title: 'TMT Bar Weight Chart', desc: '6mm–40mm reference with kg/m, 12m bar weight, and formula.', href: '/guides/tmt-bar-weight-chart', tag: 'TMT / REBAR' },
  { title: 'Steel Weight Formulas', desc: 'Practical formulas for bars, plates, pipes, flats, and hollow sections.', href: '/guides/steel-weight-formulas', tag: 'FORMULAS' }
];
---
<Layout title="Steel Guides | SteelCalc" description="Practical steel weight formulas, TMT reference charts, and calculation guides from SteelCalc.">
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>Steel<span class="light">Calc</span><small>PRECISION TOOLS</small></span></a>
      <nav><a href="/calculators">Calculators</a><a class="active" href="/guides">Guides</a><a href="/workbench">Workbench</a></nav>
      <a class="cta" href="/calculators">All calculators →</a>
    </header>
    <main>
      <div class="eyebrow">STEELCALC KNOWLEDGE</div>
      <h1>Guides that explain the <em>numbers.</em></h1>
      <p class="intro">Use these reference pages to verify formulas, check common sizes, and understand what a calculated steel weight actually represents.</p>
      <div class="grid">
        {guides.map((guide) => <a class="card" href={guide.href}><span>{guide.tag}</span><h2>{guide.title}</h2><p>{guide.desc}</p><b>Read guide →</b></a>)}
      </div>
      <section class="workbench-callout">
        <div><span class="eyebrow">NEXT STEP</span><h2>Need more than one item?</h2><p>Add multiple TMT, plate, pipe, and bar items into one project and get combined weight and cost.</p></div>
        <a href="/workbench">Open project workbench →</a>
      </section>
    </main>
  </div>
</Layout>

<style>
:global(body){margin:0;background:#f7f8f9;color:#17212b;font-family:Inter,ui-sans-serif,system-ui}
.shell{max-width:1180px;margin:0 auto;padding:0 28px 70px}.topbar{height:82px;display:flex;align-items:center;gap:26px;border-bottom:1px solid #e4e7e9}.brand{display:flex;align-items:center;gap:9px;margin-right:auto;text-decoration:none;color:#17212b;font-size:18px;font-weight:850}.light{font-weight:450;color:#69747d}.brand small{display:block;font-size:6px;letter-spacing:1.7px;color:#8b969d;margin-top:5px}.brand-mark{width:28px;height:28px;background:#eca43c;border-radius:7px;display:flex;align-items:flex-end;justify-content:center;gap:3px;padding:6px}.brand-mark span{display:block;width:4px;background:#17212b}.brand-mark span:nth-child(1){height:7px}.brand-mark span:nth-child(2){height:12px}.brand-mark span:nth-child(3){height:9px}nav{display:flex;gap:23px}nav a{font-size:10px;font-weight:700;color:#68747d;text-decoration:none}nav a:hover,nav a.active{color:#17212b}.cta{font-size:9px;font-weight:800;color:#fff;text-decoration:none;background:#d9932f;padding:10px 12px;border-radius:6px}
main{padding-top:52px}.eyebrow{font-size:7px;letter-spacing:1.8px;font-weight:850;color:#8b959d}h1{font-size:clamp(42px,5vw,64px);line-height:1.02;letter-spacing:-3.5px;margin:16px 0 15px}h1 em,h2 em{font-family:Georgia,serif;font-weight:500;color:#d9932f}.intro{max-width:680px;font-size:11px;line-height:1.8;color:#65727b;margin:0}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:32px}.card{background:#fff;border:1px solid #e1e5e8;border-radius:7px;padding:22px;text-decoration:none;color:inherit;transition:.18s}.card:hover{transform:translateY(-3px);border-color:#d7b576;box-shadow:0 14px 28px #17232d0c}.card>span{font-size:7px;font-weight:850;letter-spacing:1.4px;color:#c4862c}.card h2{font-size:22px;margin:13px 0 8px;letter-spacing:-.8px}.card p{font-size:10px;line-height:1.75;color:#7b8790;margin:0 0 18px}.card b{font-size:9px;color:#5e6b74}.workbench-callout{display:flex;justify-content:space-between;gap:25px;align-items:center;margin-top:36px;padding:23px;border:1px solid #dfe4e7;background:#18252f;border-radius:8px;color:#fff}.workbench-callout h2{font-size:22px;margin:8px 0;color:#fff}.workbench-callout p{max-width:650px;font-size:9px;line-height:1.7;color:#b8c2c8;margin:0}.workbench-callout>a{white-space:nowrap;color:#fff;background:#d9932f;padding:11px 14px;border-radius:6px;font-size:9px;font-weight:800;text-decoration:none}@media(max-width:700px){.shell{padding:0 18px 50px}.topbar{height:70px}.topbar nav{display:none}.grid{grid-template-columns:1fr}.workbench-callout{align-items:flex-start;flex-direction:column}.workbench-callout>a{white-space:normal}}
</style>